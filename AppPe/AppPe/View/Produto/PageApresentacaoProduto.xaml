<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Produto.PageApresentacaoProduto"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:produto="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Produto;assembly=Xamarin.HLP.Mobile.AppPE">
    <ContentPage.BindingContext>
        <produto:ProdutoAprosentacaoViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LabelApresentacao" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource CinzaApresentacaoCliente}" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeContentApresentacao}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Title>
        <OnPlatform
            x:TypeArguments="x:String"
            Android="Apresentação"
            WinPhone="Apresentação"
            iOS="Apresentação" />
    </ContentPage.Title>

    <ScrollView
        AbsoluteLayout.LayoutBounds="0,0,1,1"
        AbsoluteLayout.LayoutFlags="All"
        BackgroundColor="{StaticResource CinzaMedio}"
        Orientation="Vertical">
        <StackLayout Orientation="Vertical">
            <!--<xaml:MyCardView ShowImage="True" IsCardView="True"  CardImage="{Binding currentModel.GetImageSource}" Title="{Binding currentModel.xNome}"
                             Display="{Binding xUN}" />-->

            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CarouselView
                    x:Name="ImageCarouselView"
                    Grid.Row="0"
                    HeightRequest="250"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding ListaImagens}"
                    VerticalOptions="FillAndExpand">
                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Image
                                Aspect="AspectFill"
                                HorizontalOptions="FillAndExpand"
                                Source="{Binding .}"
                                VerticalOptions="FillAndExpand" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <StackLayout
                    Grid.Row="1"
                    Padding="18,8,0,10"
                    BackgroundColor="{StaticResource Branco}"
                    Orientation="Vertical">
                    <Label
                        FontSize="Medium"
                        LineBreakMode="TailTruncation"
                        Text="{Binding currentModel.cAlternativo}"
                        TextColor="{StaticResource CinzaEscuro}"
                        VerticalTextAlignment="Center" />
                    <Label
                        FontSize="Small"
                        LineBreakMode="TailTruncation"
                        Text="{Binding currentModel.xDescricao}"
                        TextColor="{StaticResource CinzaApresentacaoCliente}"
                        VerticalTextAlignment="Center" />
                </StackLayout>

                <Frame
                    Grid.Row="2"
                    Padding="0,0,0,0"
                    HasShadow="True">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="GridHeader"
                            Padding="5,5,5,5"
                            BackgroundColor="{StaticResource Rosa}">
                            <Label
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="DADOS PRINCIPAIS"
                                TextColor="White" />
                        </Grid>

                        <Grid
                            x:Name="GridContent"
                            Grid.Row="1"
                            BackgroundColor="White">
                            <Grid.Padding>
                                <OnPlatform
                                    x:TypeArguments="Thickness"
                                    Android="5,5,5,5"
                                    WinPhone="5,5,5,5"
                                    iOS="12,5,12,5" />
                            </Grid.Padding>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  NOME / CÓDIGO  -->

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*" />
                                    <ColumnDefinition Width="45*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="NOME"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding currentModel.xNome}" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="CÓDIGO"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding currentModel.cAlternativo}" />
                                </Grid>


                            </Grid>

                            <!--  UNIDADE / REPRESENTAÇÃO  -->

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*" />
                                    <ColumnDefinition Width="45*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="UNIDADE"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding xUN}" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="REPRESENTAÇÃO"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding xRepresentada}" />
                                </Grid>


                            </Grid>

                            <!--  CATEGORIA / FABRICANTE  -->

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*" />
                                    <ColumnDefinition Width="45*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="CATEGORIA"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding xCategoria}" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="FABRICANTE"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding currentModel.xFabricante}" />
                                </Grid>


                            </Grid>

                            <!--  VENDA SEM ESTOQUE / ATIVO  -->

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*" />
                                    <ColumnDefinition Width="45*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="VENDA SEM ESTOQUE"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding currentModel.stVendaSemEstoque, Converter={StaticResource BoolToStringConverter}}" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="ATIVO"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                    <Label
                                        Grid.Row="1"
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource LabelApresentacao}"
                                        Text="{Binding currentModel.stAtivo, Converter={StaticResource BoolToStringConverter}}" />
                                </Grid>


                            </Grid>

                            <!--  OBSERVAÇÃO  -->

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="{StaticResource FontSizePedidoApresentacao}"
                                    LineBreakMode="TailTruncation"
                                    Text="OBSERVAÇÃO"
                                    TextColor="{StaticResource CinzaEscuro}" />
                                <Label
                                    Grid.Row="1"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding currentModel.xAnotacao}" />

                            </Grid>

                        </Grid>

                    </Grid>
                </Frame>

                <Frame
                    Grid.Row="1"
                    Padding="0,0,0,0"
                    HasShadow="True">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="GridHeaderValores"
                            Padding="5,5,5,5"
                            BackgroundColor="{StaticResource VerdePedido}">
                            <Label
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="VALORES"
                                TextColor="White" />
                        </Grid>

                        <Grid
                            x:Name="GridContentValores"
                            Grid.Row="1"
                            BackgroundColor="White">
                            <Grid.Padding>
                                <OnPlatform
                                    x:TypeArguments="Thickness"
                                    Android="5,5,5,5"
                                    WinPhone="5,5,5,5"
                                    iOS="12,5,12,5" />
                            </Grid.Padding>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  CUSTO DO PRODUTO  -->

                            <Grid IsVisible="{Binding isAdm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        LineBreakMode="TailTruncation"
                                        Text="CUSTO DO PRODUTO"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                </Grid>
                                <Label
                                    Grid.Column="1"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding xDot}" />
                                <Label
                                    Grid.Column="2"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding currentModel.vCusto, Converter={StaticResource FormatDecimalConverter}}" />

                            </Grid>

                            <!--  LUCRO  -->

                            <Grid Grid.Row="1" IsVisible="{Binding isAdm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        Text="LUCRO"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                </Grid>
                                <Label
                                    Grid.Column="1"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding xDot}" />
                                <Label
                                    Grid.Column="2"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding currentModel.pLucro, Converter={StaticResource FormatToPorcentConvert}}" />


                            </Grid>

                            <!--  IPI SOBRE VENDA  -->

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        Text="IPI SOBRE VENDA"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                </Grid>
                                <Label
                                    Grid.Column="1"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding xDot}" />
                                <Label
                                    Grid.Column="2"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding currentModel.pIpiVenda, Converter={StaticResource FormatToPorcentConvert}}" />


                            </Grid>

                            <!--  IPI SOBRE VENDA  -->

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{StaticResource FontSizePedidoApresentacao}"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        Text="ST SOBRE VENDA"
                                        TextColor="{StaticResource CinzaEscuro}" />
                                </Grid>
                                <Label
                                    Grid.Column="1"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding xDot}" />
                                <Label
                                    Grid.Column="2"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource LabelApresentacao}"
                                    Text="{Binding currentModel.pStVenda, Converter={StaticResource FormatToPorcentConvert}}" />


                            </Grid>

                            <!--  SEPARADOR  -->

                            <Grid Grid.Row="4" Padding="-5,10,-5,0">
                                <BoxView BackgroundColor="{StaticResource Rosa}" HeightRequest="1" />
                            </Grid>

                            <!--  VALO DE VENDA  -->

                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Padding="0,2,0,0">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        LineBreakMode="TailTruncation"
                                        Text="VALOR DE VENDA"
                                        TextColor="{StaticResource VerdePedido}" />
                                </Grid>

                                <Label
                                    Grid.Column="2"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding currentModel.vVenda, Converter={StaticResource FormatDecimalConverter}}"
                                    TextColor="{StaticResource VerdePedido}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Frame>

                <Frame
                    Grid.Row="3"
                    Padding="0,0,0,0"
                    HasShadow="True"
                    IsVisible="{Binding currentModel.stControleEstoque}">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="GridHeaderEstoque"
                            Padding="5,5,5,5"
                            BackgroundColor="{StaticResource AzulClaro}">
                            <Label
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                Text="ESTOQUE"
                                TextColor="White" />
                            <Label
                                FontAttributes="None"
                                FontSize="Micro"
                                HorizontalTextAlignment="End"
                                Text="{Binding currentModel.dtUltimaSincronizacaoEstoque}"
                                TextColor="White" />
                        </Grid>

                        <Grid
                            x:Name="GridContentEstoque"
                            Grid.Row="1"
                            BackgroundColor="White">
                            <!--<Grid.Padding>
        <OnPlatform x:TypeArguments="Thickness" Android="5,5,5,5" WinPhone="5,5,5,5" iOS="12,5,12,5"/>
    </Grid.Padding>-->

                            <ListView
                                HasUnevenRows="True"
                                ItemsSource="{Binding currentModel.lEstoqueProduto}"
                                MinimumHeightRequest="5"
                                SeparatorVisibility="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid
                                                Padding="5"
                                                ColumnSpacing="2"
                                                RowSpacing="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--<Image Source="box.png"
                               HeightRequest="33"
                               HorizontalOptions="CenterAndExpand"
                               Aspect="AspectFill"
                               WidthRequest="33"/>-->

                                                <Label
                                                    Grid.Column="0"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="Start"
                                                    Opacity="0.8"
                                                    Text="{Binding xNomeGrade}"
                                                    TextColor="Gray" />

                                                <Label
                                                    Grid.Column="1"
                                                    FontAttributes="Bold"
                                                    FontSize="Small"
                                                    HorizontalOptions="Start"
                                                    Opacity="1"
                                                    Text="{Binding vEstoque}" />

                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>
                        </Grid>
                    </Grid>
                </Frame>

            </Grid>
        </StackLayout>

    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding AtualizarCommand}"
            Icon="{Binding ImageIconEdit}"
            Text="Alterar" />
        <ToolbarItem
            Command="{Binding DeleteCommand}"
            Icon="{Binding ImageIconDelete}"
            Text="Deletar">
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" Android="Secondary" />
            </ToolbarItem.Order>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
</ContentPage>