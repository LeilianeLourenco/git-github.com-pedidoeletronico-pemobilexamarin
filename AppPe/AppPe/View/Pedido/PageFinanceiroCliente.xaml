<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:binding="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageFinanceiroCliente"  Title="Títulos a receber">
    <ContentPage.BindingContext>
        <binding:PageFinanceiroClienteViewModel/>
    </ContentPage.BindingContext>
    
    <Grid>
        <CollectionView x:Name="collectionListView"
                         ItemsSource="{Binding Financeiros}"  
                         VerticalScrollBarVisibility="Always"
                         RemainingItemsThreshold="1"
                         RemainingItemsThresholdReached="LoadMoreInfo">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid BackgroundColor="White" RowSpacing="0" ColumnSpacing="0" Padding="5,1,5,1" Margin="2,2,2,1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Text="{Binding SequenciaTitulo}" Grid.Row="0" Grid.Column="0" TextColor="{StaticResource CinzaEscuro}"/>
                        <Label Text="{Binding ValorTitulo}" Grid.Row="0" Grid.Column="1" TextColor="{StaticResource VermelhoPrincipal}"  HorizontalTextAlignment="End"/>

                        <Label Text="{Binding xDtEmissao}" Grid.Row="1" Grid.Column="0" TextColor="{StaticResource CinzaEscuro}"/>
                        <Label Text="{Binding xDtVencimento}" Grid.Row="1" Grid.Column="1" TextColor="{StaticResource CinzaEscuro}"  HorizontalTextAlignment="End"/>
                        <!-- Separator -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{StaticResource CinzaClarissimo}"
                                 Grid.ColumnSpan="2"
                                 Grid.Row="2"
                                 VerticalOptions="End"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
