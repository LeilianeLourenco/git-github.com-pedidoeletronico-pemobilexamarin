<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:behaviors="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model.Lancamento.Behaviors;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:pedido1="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageListarProdutosNew" IsBusy="{Binding IsBusy}">
  <ContentPage.Title>
    <OnPlatform x:TypeArguments="x:String" Android="Produtos" WinPhone="Produtos" />
  </ContentPage.Title>
  <ContentPage.BindingContext>
    <pedido:ListarProdutosNewViewModel/>
  </ContentPage.BindingContext>
  <ContentPage.Resources>
    <ResourceDictionary>
      <pedido1:QtdeItemEditItemConverter x:Key="QtdeItemPedidoConverter"/>
      <pedido1:BoolToColorConverter x:Key="BoolToColorConverter"/>

      <Style TargetType="Label" x:Key="HeaderLabelProduto">
        <Setter Property="FontSize">
          <Setter.Value>
            <OnPlatform x:TypeArguments="x:Double" iOS="9" Android="9" WinPhone="14"/>
          </Setter.Value>
        </Setter>
        <Setter Property="TextColor" Value="{StaticResource CinzaPrincipal}" />
        <Setter Property="Margin">
          <Setter.Value>
            <OnPlatform x:TypeArguments="Thickness">
              <OnPlatform.WinPhone>0,0,0,0</OnPlatform.WinPhone>
              <OnPlatform.Android>5,0,0,-8</OnPlatform.Android>
              <OnPlatform.iOS>0,0,0,0</OnPlatform.iOS>
            </OnPlatform>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </ContentPage.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" IsVisible="{Binding bFind}" Padding="5,5,5,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <xaml:SearchPE Grid.Column="0" x:Name="SearchBarPesquisa" SearchCommand="{Binding SearchCommand}" Placeholder="pesquisar..." Text="{Binding xFiltro, Mode=TwoWay}" />
      <Grid Grid.Column="1" x:Name="GridPesquisaBarCode">
        <abstractions:SvgImage x:Name="btnExecutePesquisaBarCode" HorizontalOptions="Center" VerticalOptions="Center" SvgPath="{StaticResource ImagemPesquisarBarCode}" >
          <abstractions:SvgImage.HeightRequest>
            <OnPlatform x:TypeArguments="x:Double" WinPhone="40" Android="34" iOS="30"/>
          </abstractions:SvgImage.HeightRequest>
          <abstractions:SvgImage.WidthRequest>
            <OnPlatform x:TypeArguments="x:Double" WinPhone="40" Android="34" iOS="30"/>
          </abstractions:SvgImage.WidthRequest>
        </abstractions:SvgImage>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" RowSpacing="0" IsVisible="False" x:Name="GridImpostos" Padding="5,0,5,0">
      <Grid.RowDefinitions>
        <RowDefinition  Height="Auto"/>
        <RowDefinition  Height="Auto"/>
        <RowDefinition  Height="Auto"/>
        <RowDefinition  Height="Auto"/>
      </Grid.RowDefinitions>

      <StackLayout IsVisible="{Binding bUsaLocaisEstoque}" Grid.Row="0" x:Name="StackLayoutLocalEstoque">
     
      <custom:BindablePickerV2 HorizontalOptions="FillAndExpand" DisplayMemberPath="Display" ItemsSource="{Binding ListaLocalEstoque}" SelectedItem="{Binding CurrentLocalEstoque, Mode=TwoWay}" />
    
      </StackLayout>
         
      <StackLayout Grid.Row="1" x:Name="StackLayoutListaPreco">

        <custom:BindablePickerV2 HorizontalOptions="FillAndExpand" DisplayMemberPath="Display" ItemsSource="{Binding ListaTabelaPreco}" SelectedItem="{Binding CurrentTabelaPreco, Mode=TwoWay}" />

      </StackLayout>

      <Grid Grid.Row="2" ColumnSpacing="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="25*"/>
          <ColumnDefinition Width="25*"/>
          <ColumnDefinition Width="25*"/>
          <ColumnDefinition Width="25*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"  
               Grid.Column="0" 
               Text="QUANTIDADE"
               LineBreakMode="NoWrap"
               Style="{StaticResource HeaderLabelProduto}"/>
        <Label Grid.Row="0"
               Grid.Column="1" 
               Text="R$ UNITÁRIO C/IMP" 
               LineBreakMode="NoWrap" 
               Style="{StaticResource HeaderLabelProduto}" />
        <Label Grid.Row="0" 
               Grid.Column="2" 
               Text="% DESCONTO" 
               LineBreakMode="NoWrap" 
               Style="{StaticResource HeaderLabelProduto}" />
        <Label Grid.Row="0" 
               Grid.Column="3" 
               Text="R$ DESCONTO" 
               LineBreakMode="NoWrap" 
               Style="{StaticResource HeaderLabelProduto}"/>


        <custom:ExtendedEntry 
            Grid.Row="1"  
            x:Name="EntryQtde"
            Keyboard="Numeric" 
            IsVisible="{Binding HasGradeSelected, Converter={StaticResource InvertBoolConvert}}"                         
            Grid.Column="0" 
            Placeholder="0" 
            Text="{Binding editarItemViewModel.currentModel.vQtdItem, Converter={StaticResource QtdeItemPedidoConverter}}"
            PropertyChanged="EntryQtde_OnPropertyChanged"/>

        <Entry Grid.Row="1" 
               Keyboard="Numeric" 
               IsEnabled="False" 
               IsVisible="{Binding HasGradeSelected}" 
               Text="{Binding editarItemViewModel.vQtdeTotal, Converter={StaticResource QtdeItemPedidoConverter}}"
               Grid.Column="0" Placeholder="0"/>

        <custom:ExtendedEntry Grid.Row="1" 
                              IsEnabled="{Binding editarItemViewModel.currentModel.currentTabelaPreco.bEscalonada, Converter={StaticResource InvertBoolConvert}}" 
                              x:Name="EntryValorUnitario" 
                              Grid.Column="1"
                              Placeholder="0,00"
                              Text="{Binding editarItemViewModel.vUnitarioVendaComImpostos, Converter={StaticResource DecimalToStringConverter}}"
                              Keyboard="Numeric">
          <custom:ExtendedEntry.Behaviors>
            <behaviors:ValorUnitarioComImpostosBehaviors x:Name="ValorUnitarioComImpostos" />
          </custom:ExtendedEntry.Behaviors>
        </custom:ExtendedEntry>

        <custom:ExtendedEntry Grid.Row="1"   
                              x:Name="EntryDesconto" 
                              TextColor="{Binding Source={x:Reference DescontoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}"
                              Grid.Column="2" 
                              Placeholder="0" 
                              Text="{Binding editarItemViewModel.pDesconto, Converter={StaticResource DecimalToStringConverter}}" 
                              Keyboard="Numeric">
          <custom:ExtendedEntry.Behaviors>
            <behaviors:DescontoItemBehaviors x:Name="DescontoPorcent" TpValidacao="PORCENTAGEM" />
          </custom:ExtendedEntry.Behaviors>
        </custom:ExtendedEntry>

        <custom:ExtendedEntry Grid.Row="1" x:Name="EntryValorDesconto" TextColor="{Binding Source={x:Reference DescontoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}" Grid.Column="3" Placeholder="0,00"
                      Text="{Binding editarItemViewModel.vDesconto, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric">
          <custom:ExtendedEntry.Behaviors>
            <behaviors:DescontoItemBehaviors x:Name="DescontoValor" TpValidacao="VALOR" />
          </custom:ExtendedEntry.Behaviors>
        </custom:ExtendedEntry>

      </Grid>

      <Grid Grid.Row="3" ColumnSpacing="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30*"/>
          <ColumnDefinition Width="30*"/>
          <ColumnDefinition Width="40*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Text="% COMISSÃO" LineBreakMode="TailTruncation" TextColor="{Binding Source={x:Reference ComissaoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}" FontSize="9">
          <Label.Margin>
            <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8"/>
          </Label.Margin>
        </Label>
        <Label Grid.Row="0" Grid.Column="1" Text="R$ COMISSÃO" LineBreakMode="TailTruncation" TextColor="{Binding Source={x:Reference ComissaoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}" FontSize="9">
          <Label.Margin>
            <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8"/>
          </Label.Margin>
        </Label>
        <Label Grid.Row="0" Grid.Column="2" Text="R$ SUBTOTAL" LineBreakMode="TailTruncation" TextColor="{StaticResource VerdePedido}" FontSize="9">
          <Label.Margin>
            <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8"/>
          </Label.Margin>
        </Label>

        <custom:ExtendedEntry IsEnabled="{Binding editarItemViewModel.currentModel.currentTabelaPreco.canEditComissao}"  Keyboard="Numeric"  x:Name="EntryPComissao" Grid.Row="1" TextColor="{Binding Source={x:Reference ComissaoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}"
                       Grid.Column="0"  Placeholder="0" Text="{Binding editarItemViewModel.pComissao, Converter={StaticResource DecimalPlacesToStringConverter}}">
          <custom:ExtendedEntry.Behaviors>
            <behaviors:ComissaoItemBehaviors x:Name="ComissaoPorcent" TpValidacao="PORCENTAGEM" />
          </custom:ExtendedEntry.Behaviors>
        </custom:ExtendedEntry>
        <custom:ExtendedEntry IsEnabled="{Binding editarItemViewModel.currentModel.currentTabelaPreco.canEditComissao}" Keyboard="Numeric"  x:Name="EntryValorComissao" Grid.Row="1" TextColor="{Binding Source={x:Reference ComissaoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}" Grid.Column="1"  Placeholder="0,00"
                       Text="{Binding editarItemViewModel.vComissao, Converter={StaticResource DecimalToStringConverter}}" >
          <custom:ExtendedEntry.Behaviors>
            <behaviors:ComissaoItemBehaviors x:Name="ComissaoValor" TpValidacao="VALOR" />
          </custom:ExtendedEntry.Behaviors>
        </custom:ExtendedEntry>

        <custom:ExtendedEntry Grid.Row="1" Grid.Column="2" IsEnabled="False" Placeholder ="0,00" Text="{Binding editarItemViewModel.vSubTotal,  Converter={StaticResource DecimalToStringConverter}}"/>

      </Grid>

    </Grid>

    <custom:InfiniteSimpleListView x:Name="ListViewDados"
                                   Grid.Row="2"
                                   ItemsSource="{Binding Produtos}"
                                   IsEnabled="{x:Binding bListaItensHabilitada}"
                                   HasUnevenRows="True"  
                                   SelectedItem="{Binding itemSelected, Mode=TwoWay}"
                                   LoadMoreCommand="{Binding LoadItensCommand}"
                                   ItemSelected="ListViewDados_OnItemSelected">
            <!--<x:Arguments>
                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
            </x:Arguments>-->
            <!--<ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>-->
    </custom:InfiniteSimpleListView>

  </Grid>

  <ContentPage.ToolbarItems>


    <ToolbarItem Clicked="MenuItem_OnClicked" >
      <ToolbarItem.Order>
        <OnPlatform x:TypeArguments="ToolbarItemOrder" Android="Secondary" WinPhone="Secondary" />
      </ToolbarItem.Order>
      <ToolbarItem.Text>
        <OnPlatform x:TypeArguments="x:String" Android="Mudar tipo de Lista" WinPhone="Mudar tipo de Lista"/>
      </ToolbarItem.Text>
      <ToolbarItem.Icon>
        <OnPlatform x:TypeArguments="FileImageSource" iOS="TrocaLista.png" />
      </ToolbarItem.Icon>
    </ToolbarItem>

    <ToolbarItem Command="{Binding ConfiguracaoCommand}">
      <ToolbarItem.Order>
        <OnPlatform x:TypeArguments="ToolbarItemOrder" Android="Secondary" WinPhone="Secondary" />
      </ToolbarItem.Order>
      <ToolbarItem.Text>
        <OnPlatform x:TypeArguments="x:String" Android="Configurar Pesquisa" WinPhone="Configurar Pesquisa" />
      </ToolbarItem.Text>
      <ToolbarItem.Icon>
        <OnPlatform x:TypeArguments="FileImageSource" iOS="PesquisaAvancada.png" />
      </ToolbarItem.Icon>
    </ToolbarItem>

    <ToolbarItem x:Name="toolbarEscalonada" Icon="{Binding ImageIconPedido}" Command="{Binding itemSelected.TableEscalonada}" Order="Primary" />

    <ToolbarItem Icon="{Binding ImageIconSearch}" Command="{Binding HabiliteToSearchCommand}" Order="Primary" />

    <ToolbarItem Icon="{Binding ImageIconEdit}"  Command="{Binding itemSelected.EditItemPedidoCommand}" Order="Primary" />

    <ToolbarItem x:Name="ToolbarItemSave" Icon="{Binding ImageIconSave}" Order="Primary">
    </ToolbarItem>



  </ContentPage.ToolbarItems>
    
</ContentPage>