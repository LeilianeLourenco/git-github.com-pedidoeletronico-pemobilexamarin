<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageListarProdutosNew"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:behaviors="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model.Lancamento.Behaviors;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido1="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
    IsBusy="{Binding IsBusy}">
    <ContentPage.Title>
        <OnPlatform
            x:TypeArguments="x:String"
            Android="Produtos"
            WinPhone="Produtos" />
    </ContentPage.Title>
    <ContentPage.BindingContext>
        <pedido:ListarProdutosNewViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <pedido1:QtdeItemEditItemConverter x:Key="QtdeItemPedidoConverter" />
            <pedido1:BoolToColorConverter x:Key="BoolToColorConverter" />

            <Style x:Key="HeaderLabelProduto" TargetType="Label">
                <Setter Property="FontSize">
                    <Setter.Value>
                        <OnPlatform
                            x:TypeArguments="x:Double"
                            Android="9"
                            WinPhone="14"
                            iOS="9" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextColor" Value="{StaticResource CinzaPrincipal}" />
                <Setter Property="Margin">
                    <Setter.Value>
                        <OnPlatform x:TypeArguments="Thickness">
                            <OnPlatform.WinPhone>0,0,0,0</OnPlatform.WinPhone>
                            <OnPlatform.Android>5,0,0,-8</OnPlatform.Android>
                            <OnPlatform.iOS>0,0,0,0</OnPlatform.iOS>
                        </OnPlatform>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="5,5,5,5"
            IsVisible="{Binding bFind}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <xaml:SearchPE
                x:Name="SearchBarPesquisa"
                Grid.Column="0"
                Placeholder="pesquisar..."
                SearchCommand="{Binding SearchCommand}"
                Text="{Binding xFiltro, Mode=TwoWay}" />
            <Grid x:Name="GridPesquisaBarCode" Grid.Column="1">
                <abstractions:SvgImage
                    x:Name="btnExecutePesquisaBarCode"
                    HorizontalOptions="Center"
                    SvgPath="{StaticResource ImagemPesquisarBarCode}"
                    VerticalOptions="Center">
                    <abstractions:SvgImage.HeightRequest>
                        <OnPlatform
                            x:TypeArguments="x:Double"
                            Android="34"
                            WinPhone="40"
                            iOS="30" />
                    </abstractions:SvgImage.HeightRequest>
                    <abstractions:SvgImage.WidthRequest>
                        <OnPlatform
                            x:TypeArguments="x:Double"
                            Android="34"
                            WinPhone="40"
                            iOS="30" />
                    </abstractions:SvgImage.WidthRequest>
                </abstractions:SvgImage>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                <StackLayout
                    x:Name="ScrollButtonsFiltros"
                    Margin="10,10,10,10"
                    Orientation="Horizontal">
                    <Button
                        Clicked="ButtonFiltros_OnClicked"
                        Command="{Binding AplicaFiltroItensCommand}"
                        CornerRadius="50"
                        Text="Itens">
                        <Button.BackgroundColor>
                            <OnPlatform x:TypeArguments="Color" Android="{StaticResource CinzaEscuro}" />
                        </Button.BackgroundColor>
                        <Button.TextColor>
                            <OnPlatform
                                x:TypeArguments="Color"
                                Android="{StaticResource Branco}"
                                iOS="{StaticResource CinzaEscuro}" />
                        </Button.TextColor>
                    </Button>
                    <Button
                        Clicked="ButtonFiltros_OnClicked"
                        Command="{Binding AplicaFiltroRecorrenciaCommand}"
                        CornerRadius="50"
                        Text="Recorrência" />
                    <Button
                        Clicked="ButtonFiltros_OnClicked"
                        Command="{Binding AplicaFiltroCampanhaCommand}"
                        CornerRadius="50"
                        Text="Campanhas" />
                    <Button
                        Clicked="ButtonFiltros_OnClicked"
                        Command="{Binding AplicaFiltroDestaquesCommand}"
                        CornerRadius="50"
                        Text="Destaques" />
                </StackLayout>
            </ScrollView>
        </Grid>

        <Grid
            x:Name="GridImpostos"
            Grid.Row="2"
            Padding="5,0,5,0"
            IsVisible="False"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackLayout
                x:Name="StackLayoutLocalEstoque"
                Grid.Row="0"
                IsVisible="{Binding bUsaLocaisEstoque}">

                <custom:BindablePickerV2
                    DisplayMemberPath="Display"
                    HorizontalOptions="FillAndExpand"
                    ItemsSource="{Binding ListaLocalEstoque}"
                    SelectedItem="{Binding CurrentLocalEstoque, Mode=TwoWay}" />

            </StackLayout>

            <StackLayout
                x:Name="StackLayoutListaPreco"
                Grid.Row="1"
                Margin="0,0,0,10">
                <StackLayout Margin="5,0,0,0">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PopupTabelaPreco" />
                    </StackLayout.GestureRecognizers>
                    <Label
                        FontSize="18"
                        Text="{Binding CurrentTabelaPreco.Display}"
                        TextColor="#000" />
                </StackLayout>
            </StackLayout>

            <Grid Grid.Row="2" ColumnSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="25*" />
                    <ColumnDefinition Width="25*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    LineBreakMode="NoWrap"
                    Style="{StaticResource HeaderLabelProduto}"
                    Text="QUANTIDADE" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    LineBreakMode="NoWrap"
                    Style="{StaticResource HeaderLabelProduto}"
                    Text="R$ UNITÁRIO C/IMP" />
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    LineBreakMode="NoWrap"
                    Style="{StaticResource HeaderLabelProduto}"
                    Text="% DESCONTO" />
                <Label
                    Grid.Row="0"
                    Grid.Column="3"
                    LineBreakMode="NoWrap"
                    Style="{StaticResource HeaderLabelProduto}"
                    Text="R$ DESCONTO" />


                <custom:ExtendedEntry
                    x:Name="EntryQtde"
                    Grid.Row="1"
                    Grid.Column="0"
                    IsVisible="{Binding HasGradeSelected, Converter={StaticResource InvertBoolConvert}}"
                    Keyboard="Numeric"
                    Placeholder="0"
                    PropertyChanged="EntryQtde_OnPropertyChanged"
                    Text="{Binding editarItemViewModel.currentModel.vQtdItem, Converter={StaticResource QtdeItemPedidoConverter}}"
                    TextChanged="EntryQtde_OnTextChanged" />

                <Entry
                    Grid.Row="1"
                    Grid.Column="0"
                    IsEnabled="False"
                    IsVisible="{Binding HasGradeSelected}"
                    Keyboard="Numeric"
                    Placeholder="0"
                    Text="{Binding editarItemViewModel.vQtdeTotal, Converter={StaticResource QtdeItemPedidoConverter}}" />

                <custom:ExtendedEntry
                    x:Name="EntryValorUnitario"
                    Grid.Row="1"
                    Grid.Column="1"
                    IsEnabled="{Binding editarItemViewModel.currentModel.currentTabelaPreco.bEscalonada, Converter={StaticResource InvertBoolConvert}}"
                    Keyboard="Numeric"
                    Placeholder="0,00"
                    Text="{Binding editarItemViewModel.vUnitarioVendaComImpostos, Converter={StaticResource DecimalToStringConverter}}">
                    <custom:ExtendedEntry.Behaviors>
                        <behaviors:ValorUnitarioComImpostosBehaviors x:Name="ValorUnitarioComImpostos" />
                    </custom:ExtendedEntry.Behaviors>
                </custom:ExtendedEntry>

                <custom:ExtendedEntry
                    x:Name="EntryDesconto"
                    Grid.Row="1"
                    Grid.Column="2"
                    Keyboard="Numeric"
                    Placeholder="0"
                    Text="{Binding editarItemViewModel.pDesconto, Converter={StaticResource DecimalToStringConverter}}"
                    TextColor="{Binding Source={x:Reference DescontoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <custom:ExtendedEntry.Behaviors>
                        <behaviors:DescontoItemBehaviors x:Name="DescontoPorcent" TpValidacao="PORCENTAGEM" />
                    </custom:ExtendedEntry.Behaviors>
                </custom:ExtendedEntry>

                <custom:ExtendedEntry
                    x:Name="EntryValorDesconto"
                    Grid.Row="1"
                    Grid.Column="3"
                    Keyboard="Numeric"
                    Placeholder="0,00"
                    Text="{Binding editarItemViewModel.vDesconto, Converter={StaticResource DecimalToStringConverter}}"
                    TextColor="{Binding Source={x:Reference DescontoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <custom:ExtendedEntry.Behaviors>
                        <behaviors:DescontoItemBehaviors x:Name="DescontoValor" TpValidacao="VALOR" />
                    </custom:ExtendedEntry.Behaviors>
                </custom:ExtendedEntry>

            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="30*" />
                    <ColumnDefinition Width="40*" />
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="9"
                    LineBreakMode="TailTruncation"
                    Text="% COMISSÃO"
                    TextColor="{Binding Source={x:Reference ComissaoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <Label.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8" />
                    </Label.Margin>
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    FontSize="9"
                    LineBreakMode="TailTruncation"
                    Text="R$ COMISSÃO"
                    TextColor="{Binding Source={x:Reference ComissaoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <Label.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8" />
                    </Label.Margin>
                </Label>
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    FontSize="9"
                    LineBreakMode="TailTruncation"
                    Text="R$ SUBTOTAL"
                    TextColor="{StaticResource VerdePedido}">
                    <Label.Margin>
                        <OnPlatform x:TypeArguments="Thickness" Android="5,0,0,-8" />
                    </Label.Margin>
                </Label>

                <custom:ExtendedEntry
                    x:Name="EntryPComissao"
                    Grid.Row="1"
                    Grid.Column="0"
                    IsEnabled="{Binding bAdmin}"
                    Keyboard="Numeric"
                    Placeholder="0"
                    Text="{Binding editarItemViewModel.pComissao, Converter={StaticResource DecimalPlacesToStringConverter}}"
                    TextColor="{Binding Source={x:Reference ComissaoPorcent}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <custom:ExtendedEntry.Behaviors>
                        <behaviors:ComissaoItemBehaviors x:Name="ComissaoPorcent" TpValidacao="PORCENTAGEM" />
                    </custom:ExtendedEntry.Behaviors>
                </custom:ExtendedEntry>
                <custom:ExtendedEntry
                    x:Name="EntryValorComissao"
                    Grid.Row="1"
                    Grid.Column="1"
                    IsEnabled="{Binding bAdmin}"
                    Keyboard="Numeric"
                    Placeholder="0,00"
                    Text="{Binding editarItemViewModel.vComissao, Converter={StaticResource DecimalToStringConverter}}"
                    TextColor="{Binding Source={x:Reference ComissaoValor}, Path=IsValid, Converter={StaticResource BoolToColorConverter}}">
                    <custom:ExtendedEntry.Behaviors>
                        <behaviors:ComissaoItemBehaviors x:Name="ComissaoValor" TpValidacao="VALOR" />
                    </custom:ExtendedEntry.Behaviors>
                </custom:ExtendedEntry>

                <custom:ExtendedEntry
                    Grid.Row="1"
                    Grid.Column="2"
                    IsEnabled="False"
                    Placeholder="0,00"
                    Text="{Binding editarItemViewModel.vSubTotal, Converter={StaticResource DecimalToStringConverter}}" />

            </Grid>

        </Grid>

        <custom:InfiniteSimpleListView
            x:Name="ListViewDados"
            Grid.Row="3"
            HasUnevenRows="True"
            IsEnabled="{x:Binding bListaItensHabilitada}"
            ItemSelected="ListViewDados_OnItemSelected"
            ItemsSource="{Binding Produtos}"
            LoadMoreCommand="{Binding LoadItensCommand}"
            SelectedItem="{Binding itemSelected, Mode=TwoWay}">
            <!--<x:Arguments>
                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
            </x:Arguments>-->
            <!--<ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>-->
        </custom:InfiniteSimpleListView>

    </Grid>

    <ContentPage.ToolbarItems>
        <ToolbarItem Clicked="MenuItem_OnClicked">
            <ToolbarItem.Order>
                <OnPlatform
                    x:TypeArguments="ToolbarItemOrder"
                    Android="Secondary"
                    WinPhone="Secondary" />
            </ToolbarItem.Order>
            <ToolbarItem.Text>
                <OnPlatform
                    x:TypeArguments="x:String"
                    Android="Mudar tipo de Lista"
                    WinPhone="Mudar tipo de Lista" />
            </ToolbarItem.Text>
            <ToolbarItem.Icon>
                <OnPlatform x:TypeArguments="FileImageSource" iOS="TrocaLista.png" />
            </ToolbarItem.Icon>
        </ToolbarItem>

        <ToolbarItem Command="{Binding ConfiguracaoCommand}">
            <ToolbarItem.Order>
                <OnPlatform
                    x:TypeArguments="ToolbarItemOrder"
                    Android="Secondary"
                    WinPhone="Secondary" />
            </ToolbarItem.Order>
            <ToolbarItem.Text>
                <OnPlatform
                    x:TypeArguments="x:String"
                    Android="Configurar Pesquisa"
                    WinPhone="Configurar Pesquisa" />
            </ToolbarItem.Text>
            <ToolbarItem.Icon>
                <OnPlatform x:TypeArguments="FileImageSource" iOS="PesquisaAvancada.png" />
            </ToolbarItem.Icon>
        </ToolbarItem>

        <ToolbarItem
            x:Name="toolbarEscalonada"
            Command="{Binding itemSelected.TableEscalonada}"
            Icon="{Binding ImageIconPedido}"
            Order="Primary" />

        <ToolbarItem
            Command="{Binding HabiliteToSearchCommand}"
            Icon="{Binding ImageIconSearch}"
            Order="Primary" />

        <ToolbarItem
            Command="{Binding itemSelected.EditItemPedidoCommand}"
            Icon="{Binding ImageIconEdit}"
            Order="Primary" />

        <ToolbarItem
            x:Name="ToolbarItemSave"
            Icon="{Binding ImageIconSave}"
            Order="Primary" />
    </ContentPage.ToolbarItems>

</ContentPage>