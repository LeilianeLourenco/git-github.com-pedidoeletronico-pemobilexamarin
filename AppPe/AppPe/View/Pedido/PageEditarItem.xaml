<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:behaviors="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model.Lancamento.Behaviors;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE" 
             xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE" xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageEditarItem" BackgroundColor="{StaticResource CinzaMedio}"            
             Title="Edição do item">
    <ContentPage.BindingContext>
        <pedido:EditarItemViewModel/>
    </ContentPage.BindingContext>
    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <AbsoluteLayout BackgroundColor="#ffff" Grid.Row="0">
                <ScrollView AbsoluteLayout.LayoutFlags="All"
                      AbsoluteLayout.LayoutBounds="0,0,1,1">
                    <Grid Padding="0,0,0,0">
                        <Grid.RowSpacing>
                            <OnPlatform x:TypeArguments="x:Double" iOS="10"/>
                        </Grid.RowSpacing>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CarouselView x:Name="ImageCarouselView" 
              Grid.Row="0"  
              HorizontalOptions="FillAndExpand"  
              VerticalOptions="FillAndExpand"
              HeightRequest="250"
              ItemsSource="{Binding ListaImagens}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ffimageloading:CachedImage Aspect="AspectFit"
                                            HorizontalOptions="FillAndExpand" 
                                            VerticalOptions="FillAndExpand"
                                            DownsampleToViewSize="true"
                                            Source="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <StackLayout BackgroundColor="{StaticResource Branco}"  Padding="18,8,0,10" Orientation="Vertical" Grid.Row="1">
                            <Label Text="{Binding currentModel.cAlternativo}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaEscuro}" FontSize="Medium"/>
                            <Label  Text="{Binding currentModel.xDescricao}"  VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaApresentacaoCliente}" FontSize="Small"/>
                        </StackLayout>


                        <Frame Grid.Row="2" HasShadow="True" Padding="0,0,0,0">
                            <Grid  RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="GridQuantidadeGrade" BackgroundColor="{StaticResource VerdePrincipal}" Padding="5,5,5,5">
                                    <Label Text="QUANTIDADE / GRADE" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                </Grid>

                                <!--Local Estoque-->
                                <Label Margin="5,5,0,0" Grid.Row="1" Text="Local de Estoque" IsVisible="{Binding bUsaLocaisEstoque}" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                <Grid RowSpacing="0" Grid.Row="2" IsVisible="{Binding bUsaLocaisEstoque}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <custom:BindablePicker x:Name="BindableLocalEstoque" ItemsSource="{Binding ListaLocalEstoque, Mode=TwoWay}" SelectedItem="{Binding CurrentLocalEstoque, Mode=TwoWay}" />
                                </Grid>

                                <Grid Grid.Row="3" Padding="5,5,5,5" BackgroundColor="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackLayout Orientation="Vertical" x:Name="StackLayoutItens">

                                    </StackLayout>

                                </Grid>

                            </Grid>
                        </Frame>

                        <Frame Grid.Row="3" HasShadow="True" Padding="0,0,0,0">
                            <Grid  RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="GridValoresHeader" Padding="5,5,5,5" BackgroundColor="{StaticResource VermelhoPrincipal}">
                                    <Label Text="INFORMAÇÃO DE PREÇO" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                </Grid>

                                <Grid Grid.Row="1" x:Name="GridValoresContent" Padding="5,5,5,5" BackgroundColor="White">
                                    <StackLayout Orientation="Vertical" Padding="20,10,20,0" Spacing="0">

                                        <!--VALOR DE VENDA-->
                                        <Label Margin="5,5,0,0" Text="Valor Origem" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                                        <Grid Margin="5,5,0,0" ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Label Text="{Binding xValorPromocional}" Opacity="0.7" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaClaro}" HorizontalTextAlignment="Start" VerticalOptions="End"/>
                                            <Label Grid.Column="1" Text="{Binding vUnitarioVenda, Converter={StaticResource FormatDecimalConverter}}" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaEscuro}" HorizontalTextAlignment="Start" VerticalOptions="Center"/>

                                        </Grid>



                                        <!--Tabela de Preço-->
                                        <Label Margin="5,5,0,0" Text="Tabela de Preço" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <custom:BindablePicker x:Name="BindableTabelaPreco" ItemsSource="{Binding ListaTabelaPreco, Mode=TwoWay}" SelectedItem="{Binding CurrentTabelaPreco, Mode=TwoWay}" />
                                            <Grid Margin="5,0,0,0" Grid.Row="1">
                                                <Label Text="{Binding xDescontoMaximo}" FontSize="Small" TextColor="{StaticResource AzulPrincipal}"/>
                                            </Grid>
                                        </Grid>


                                        <!--Valor Unitario Com Impostos-->
                                        <Label Margin="5,5,0,0" Text="Valor Unitário de Venda" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry MaxLength="14" IsEnabled="{Binding currentModel.currentTabelaPreco.BloquearValor, Converter={StaticResource InvertBoolConvert} }"
                          x:Name="EntryValorUnitario"
                                            Text="{Binding vUnitarioVendaComImpostos, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric"  >
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ValorUnitarioComImpostosBehaviors x:Name="ValorUnitarioComImpostos" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                            <Grid Grid.Column="1" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center">
                                                <abstractions:SvgImage HorizontalOptions="End"
                                            SvgPath="{StaticResource ImagemCheck}"
                                            IsVisible="{Binding Source={x:Reference ValorUnitarioComImpostos}, Path=IsValid}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage  HorizontalOptions="End"
                                                                  SvgPath="{StaticResource ImagemErro}"
                                                                  IsVisible="{Binding Source={x:Reference ValorUnitarioComImpostos}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <!--IPI DE VENDA-->
                                        <Label Margin="5,5,0,0" Text="% Ipi Venda" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <custom:ExtendedEntry IsEnabled="False" TextChanged="EntryImpostos_OnTextChanged" MaxLength="6" x:Name="EntryIpiVenda" Placeholder="% ipi"
                                            Text="{Binding pIpiVenda, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric"  />

                                        <!--ST DE VENDA-->
                                        <Label Margin="5,5,0,0" Text="% St Venda" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <custom:ExtendedEntry IsEnabled="False" TextChanged="EntryImpostos_OnTextChanged" MaxLength="6" x:Name="EntryStVenda" Placeholder="% st"
                                            Text="{Binding pStVenda, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric"  />

                                        <Label Margin="5,5,0,0" Text="Total s/impostos" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                                        <Label Margin="5,5,0,0"  TextColor="{StaticResource VerdePrincipal}" Text="{Binding vSubTotalSemImpostos,  Converter={StaticResource FormatDecimalConverter}}" />


                                        <!--% DESCONTO-->

                                        <Label Margin="5,5,0,0" Text="% Desconto" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <custom:ExtendedEntry MaxLength="6" x:Name="EntryDesconto" 
                                                                  Text="{Binding pDesconto, Converter={StaticResource DecimalToStringConverter}}"
                                                                  HorizontalTextAlignment="Start" IsEnabled="{Binding currentModel.currentTabelaPreco.bBloquearValorProdutoApp, Converter={StaticResource InvertBoolConvert}}"  Keyboard="Numeric">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:DescontoItemBehaviors x:Name="descontoPorcent" TpValidacao="PORCENTAGEM" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>

                                            <Grid Grid.Column="1" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center">
                                                <abstractions:SvgImage HorizontalOptions="End" SvgPath="{StaticResource ImagemCheck}" IsVisible="{Binding Source={x:Reference descontoPorcent}, Path=IsValid}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage  HorizontalOptions="End"
                                                                  SvgPath="{StaticResource ImagemErro}"
                                                                  IsVisible="{Binding Source={x:Reference descontoPorcent}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <!--VALOR DESCONTO-->

                                        <Label Margin="5,5,0,0" Text="Valor Desconto" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry  MaxLength="14" x:Name="EntryValorDesconto" Text="{Binding vDesconto, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric" 
                                                    IsEnabled="{Binding currentModel.currentTabelaPreco.bBloquearValorProdutoApp, Converter={StaticResource InvertBoolConvert}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:DescontoItemBehaviors x:Name="descontoValor" TpValidacao="VALOR" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                            <Grid Grid.Column="1" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center">
                                                <abstractions:SvgImage HorizontalOptions="End"
                                            SvgPath="{StaticResource ImagemCheck}"
                                            IsVisible="{Binding Source={x:Reference descontoValor}, Path=IsValid}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage  HorizontalOptions="End"
                                                                  SvgPath="{StaticResource ImagemErro}"
                                                                  IsVisible="{Binding Source={x:Reference descontoValor}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform x:TypeArguments="x:Double" Android="15" WinPhone="20" iOS="20"/>
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <Label Margin="5,5,0,0" Text="Subtotal" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                                        <Label Margin="5,5,0,0" TextColor="{StaticResource VerdePrincipal}" Text="{Binding vSubTotal,  Converter={StaticResource FormatDecimalConverter}}" />

                                        <!--Comissão-->

                                        <Label Margin="5,5,0,0" Text="% Comissão" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry  MaxLength="8" IsEnabled="False"
                                          x:Name="EntryPComissao" Text="{Binding pComissao, Converter={StaticResource DecimalPlacesToStringConverter}}" Keyboard="Numeric" >
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ComissaoItemBehaviors x:Name="ComissaoPorcent" TpValidacao="PORCENTAGEM" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                        </Grid>

                                        <!--VALOR DESCONTO-->

                                        <Label Margin="5,5,0,0" Text="Valor Comissão" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry MaxLength="14"
                                          IsEnabled="False"
                                          x:Name="EntryValorComissao" Placeholder="valor desconto" Text="{Binding vComissao, Converter={StaticResource DecimalToStringConverter}}" Keyboard="Numeric"  >
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ComissaoItemBehaviors x:Name="ComissaoValor" TpValidacao="VALOR" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                        </Grid>

                                        <!--Informações Adicionais-->

                                        <Label Margin="5,5,0,0" Text="Informações Adicionais" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"  />
                                        <Editor Keyboard="Chat" HorizontalOptions="FillAndExpand"  VerticalOptions="FillAndExpand" HeightRequest="{StaticResource HeightEditor}" Text="{Binding currentModel.xInfAdicionais}" />



                                    </StackLayout>
                                </Grid>

                            </Grid>
                        </Frame>

                    </Grid>
                </ScrollView>
                <xaml:ExtendedActivityIndicator IsRunning="True"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource AzulPrincipal}"
                                       AbsoluteLayout.LayoutFlags="PositionProportional"
                                       AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"/>
            </AbsoluteLayout>
        </Grid>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem  Icon="{Binding ImageIconSave}" Text="Salvar" Clicked="ItemSave_OnClicked" />
    </ContentPage.ToolbarItems>
</ContentPage>