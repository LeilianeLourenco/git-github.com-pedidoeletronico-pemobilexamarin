<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageEditarItem"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:behaviors="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model.Lancamento.Behaviors;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
    xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
    Title="Edição do item"
    BackgroundColor="{StaticResource CinzaMedio}">
    <ContentPage.BindingContext>
        <pedido:EditarItemViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <AbsoluteLayout Grid.Row="0">
                <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
                    <Grid Padding="0,0,0,0">
                        <Grid.RowSpacing>
                            <OnPlatform x:TypeArguments="x:Double" iOS="10" />
                        </Grid.RowSpacing>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CarouselView
                            x:Name="ImageCarouselView"
                            Grid.Row="0"
                            HeightRequest="250"
                            HorizontalOptions="FillAndExpand"
                            ItemsSource="{Binding ListaImagens}"
                            VerticalOptions="FillAndExpand">
                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ffimageloading:CachedImage
                                            Aspect="AspectFit"
                                            DownsampleToViewSize="true"
                                            HorizontalOptions="FillAndExpand"
                                            Source="{Binding .}"
                                            VerticalOptions="FillAndExpand" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <StackLayout
                            Grid.Row="1"
                            Padding="18,8,0,10"
                            BackgroundColor="{StaticResource Branco}"
                            Orientation="Vertical">
                            <Label
                                FontSize="Medium"
                                LineBreakMode="TailTruncation"
                                Text="{Binding currentModel.cAlternativo}"
                                TextColor="{StaticResource CinzaEscuro}"
                                VerticalTextAlignment="Center" />
                            <Label
                                FontSize="Small"
                                LineBreakMode="TailTruncation"
                                Text="{Binding currentModel.xDescricao}"
                                TextColor="{StaticResource CinzaApresentacaoCliente}"
                                VerticalTextAlignment="Center" />
                        </StackLayout>

                        <Frame
                            Grid.Row="2"
                            Padding="0,0,0,0"
                            HasShadow="True">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    x:Name="GridQuantidadeGrade"
                                    Padding="5,5,5,5"
                                    BackgroundColor="{StaticResource VerdePrincipal}">
                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        Text="QUANTIDADE / GRADE"
                                        TextColor="White" />
                                </Grid>

                                <!--  Local Estoque  -->
                                <Label
                                    Grid.Row="1"
                                    Margin="5,5,0,0"
                                    IsVisible="{Binding bUsaLocaisEstoque}"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="Local de Estoque" />
                                <Grid
                                    Grid.Row="2"
                                    IsVisible="{Binding bUsaLocaisEstoque}"
                                    RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <custom:BindablePicker
                                        x:Name="BindableLocalEstoque"
                                        ItemsSource="{Binding ListaLocalEstoque, Mode=TwoWay}"
                                        SelectedItem="{Binding CurrentLocalEstoque, Mode=TwoWay}"
                                        TextColor="Black" />
                                </Grid>

                                <Grid
                                    Grid.Row="3"
                                    Padding="5,5,5,5"
                                    BackgroundColor="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackLayout x:Name="StackLayoutItens" Orientation="Vertical" />
                                </Grid>

                            </Grid>
                        </Frame>

                        <Frame
                            Grid.Row="3"
                            Padding="0,0,0,0"
                            HasShadow="True">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    x:Name="GridValoresHeader"
                                    Padding="5,5,5,5"
                                    BackgroundColor="{StaticResource VermelhoPrincipal}">
                                    <Label
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        Text="INFORMAÇÃO DE PREÇO"
                                        TextColor="White" />
                                </Grid>

                                <Grid
                                    x:Name="GridValoresContent"
                                    Grid.Row="1"
                                    Padding="5,5,5,5"
                                    BackgroundColor="White">
                                    <StackLayout
                                        Padding="20,10,20,0"
                                        Orientation="Vertical"
                                        Spacing="0">

                                        <!--  VALOR DE VENDA  -->
                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Valor Origem" />
                                        <Grid Margin="5,5,0,0" ColumnSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Label
                                                HorizontalTextAlignment="Start"
                                                LineBreakMode="TailTruncation"
                                                Opacity="0.7"
                                                Text="{Binding xValorPromocional}"
                                                TextColor="{StaticResource CinzaClaro}"
                                                VerticalOptions="End" />
                                            <Label
                                                Grid.Column="1"
                                                HorizontalTextAlignment="Start"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding vUnitarioVenda, Converter={StaticResource FormatDecimalConverter}}"
                                                TextColor="{StaticResource CinzaEscuro}"
                                                VerticalOptions="Center" />

                                        </Grid>



                                        <!--  Tabela de Preço  -->
                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Tabela de Preço" />
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackLayout Padding="5,10,5,5">
                                                <StackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="PopupTabelaPreco" />
                                                </StackLayout.GestureRecognizers>
                                                <Label
                                                    FontSize="18"
                                                    Text="{Binding CurrentTabelaPreco.Display}"
                                                    TextColor="#000" />
                                            </StackLayout>
                                            <Grid Grid.Row="1" Margin="5,0,0,0">
                                                <Label
                                                    FontSize="Small"
                                                    Text="{Binding xDescontoMaximo}"
                                                    TextColor="{StaticResource AzulPrincipal}" />
                                            </Grid>
                                        </Grid>


                                        <!--  Valor Unitario Com Impostos  -->
                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Valor Unitário de Venda" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry
                                                x:Name="EntryValorUnitario"
                                                IsEnabled="{Binding currentModel.currentTabelaPreco.BloquearValor, Converter={StaticResource InvertBoolConvert}}"
                                                Keyboard="Numeric"
                                                MaxLength="14"
                                                Text="{Binding vUnitarioVendaComImpostos, Converter={StaticResource DecimalToStringConverter}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ValorUnitarioComImpostosBehaviors x:Name="ValorUnitarioComImpostos" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference ValorUnitarioComImpostos}, Path=IsValid}"
                                                    SvgPath="{StaticResource ImagemCheck}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference ValorUnitarioComImpostos}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}"
                                                    SvgPath="{StaticResource ImagemErro}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <Label
                                            Margin="5,5,0,0"
                                            IsVisible="{Binding bExibirValorPorPeso}"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="R$ Valor por Peso" />

                                        <custom:ExtendedEntry
                                            IsEnabled="False"
                                            IsVisible="{Binding bExibirValorPorPeso}"
                                            Keyboard="Numeric"
                                            MaxLength="6"
                                            Placeholder="0,00"
                                            Text="{Binding vValorPorPeso}"
                                            TextChanged="EntryImpostos_OnTextChanged" />

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="% Ipi Venda" />

                                        <custom:ExtendedEntry
                                            x:Name="EntryIpiVenda"
                                            IsEnabled="False"
                                            Keyboard="Numeric"
                                            MaxLength="6"
                                            Placeholder="% ipi"
                                            Text="{Binding pIpiVenda, Converter={StaticResource DecimalToStringConverter}}"
                                            TextChanged="EntryImpostos_OnTextChanged"
                                            TextColor="Black" />

                                        <!--  ST DE VENDA  -->
                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="% St Venda" />

                                        <custom:ExtendedEntry
                                            x:Name="EntryStVenda"
                                            IsEnabled="False"
                                            Keyboard="Numeric"
                                            MaxLength="6"
                                            Placeholder="% st"
                                            Text="{Binding pStVenda, Converter={StaticResource DecimalToStringConverter}}"
                                            TextChanged="EntryImpostos_OnTextChanged"
                                            TextColor="Black" />

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Total s/impostos" />

                                        <Label
                                            Margin="5,5,0,0"
                                            Text="{Binding vSubTotalSemImpostos, Converter={StaticResource FormatDecimalConverter}}"
                                            TextColor="{StaticResource VerdePrincipal}" />


                                        <!--  % DESCONTO  -->

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="% Desconto" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <custom:ExtendedEntry
                                                x:Name="EntryDesconto"
                                                HorizontalTextAlignment="Start"
                                                IsEnabled="{Binding currentModel.currentTabelaPreco.bBloquearValorProdutoApp, Converter={StaticResource InvertBoolConvert}}"
                                                Keyboard="Numeric"
                                                MaxLength="6"
                                                Text="{Binding pDesconto, Converter={StaticResource DecimalToStringConverter}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:DescontoItemBehaviors x:Name="descontoPorcent" TpValidacao="PORCENTAGEM" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>

                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference descontoPorcent}, Path=IsValid}"
                                                    SvgPath="{StaticResource ImagemCheck}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference descontoPorcent}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}"
                                                    SvgPath="{StaticResource ImagemErro}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <!--  VALOR DESCONTO  -->

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Valor Desconto" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry
                                                x:Name="EntryValorDesconto"
                                                IsEnabled="{Binding currentModel.currentTabelaPreco.bBloquearValorProdutoApp, Converter={StaticResource InvertBoolConvert}}"
                                                Keyboard="Numeric"
                                                MaxLength="14"
                                                Text="{Binding vDesconto, Converter={StaticResource DecimalToStringConverter}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:DescontoItemBehaviors x:Name="descontoValor" TpValidacao="VALOR" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                            <Grid
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference descontoValor}, Path=IsValid}"
                                                    SvgPath="{StaticResource ImagemCheck}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>
                                                </abstractions:SvgImage>
                                                <abstractions:SvgImage
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding Source={x:Reference descontoValor}, Path=IsValid, Converter={StaticResource InvertBoolConvert}}"
                                                    SvgPath="{StaticResource ImagemErro}">
                                                    <abstractions:SvgImage.HeightRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.HeightRequest>
                                                    <abstractions:SvgImage.WidthRequest>
                                                        <OnPlatform
                                                            x:TypeArguments="x:Double"
                                                            Android="15"
                                                            WinPhone="20"
                                                            iOS="20" />
                                                    </abstractions:SvgImage.WidthRequest>

                                                </abstractions:SvgImage>
                                            </Grid>
                                        </Grid>

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Subtotal" />
                                        <Label
                                            Margin="5,5,0,0"
                                            Text="{Binding vSubTotal, Converter={StaticResource FormatDecimalConverter}}"
                                            TextColor="{StaticResource VerdePrincipal}" />

                                        <!--  Comissão  -->

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="% Comissão" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry
                                                x:Name="EntryPComissao"
                                                IsEnabled="{Binding bAdmin}"
                                                Keyboard="Numeric"
                                                MaxLength="8"
                                                Text="{Binding pComissao, Converter={StaticResource DecimalPlacesToStringConverter}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ComissaoItemBehaviors x:Name="ComissaoPorcent" TpValidacao="PORCENTAGEM" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                        </Grid>

                                        <!--  VALOR DESCONTO  -->

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Valor Comissão" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <custom:ExtendedEntry
                                                x:Name="EntryValorComissao"
                                                IsEnabled="False"
                                                Keyboard="Numeric"
                                                MaxLength="14"
                                                Placeholder="valor desconto"
                                                Text="{Binding vComissao, Converter={StaticResource DecimalToStringConverter}}">
                                                <custom:ExtendedEntry.Behaviors>
                                                    <behaviors:ComissaoItemBehaviors x:Name="ComissaoValor" TpValidacao="VALOR" />
                                                </custom:ExtendedEntry.Behaviors>
                                            </custom:ExtendedEntry>
                                        </Grid>

                                        <!--  Informações Adicionais  -->

                                        <Label
                                            Margin="5,5,0,0"
                                            LineBreakMode="NoWrap"
                                            Style="{StaticResource HeaderLabel}"
                                            Text="Informações Adicionais" />
                                        <Editor
                                            HeightRequest="{StaticResource HeightEditor}"
                                            HorizontalOptions="FillAndExpand"
                                            Keyboard="Chat"
                                            Text="{Binding currentModel.xInfAdicionais}"
                                            VerticalOptions="FillAndExpand" />



                                    </StackLayout>
                                </Grid>

                            </Grid>
                        </Frame>

                    </Grid>
                </ScrollView>
                <xaml:ExtendedActivityIndicator
                    AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"
                    IsRunning="True"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource AzulPrincipal}" />
            </AbsoluteLayout>
        </Grid>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Clicked="ItemSave_OnClicked"
            Icon="{Binding ImageIconSave}"
            Text="Salvar" />
    </ContentPage.ToolbarItems>
</ContentPage>