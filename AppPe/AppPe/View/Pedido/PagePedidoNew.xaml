<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PagePedidoNew"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido1="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    Title="{Binding currentModel.TipoLancamento}">

    <TabbedPage.BindingContext>
        <pedido:PedidoNewViewModel />
    </TabbedPage.BindingContext>

    <TabbedPage.Resources>
        <ResourceDictionary>
            <pedido1:DisplayToCountConverter x:Key="DisplayToCountConverter" />
        </ResourceDictionary>
    </TabbedPage.Resources>
    <TabbedPage.Children>
        <ContentPage Title="Montagem" Icon="{StaticResource IconPrincipalPedido}">
            <ContentPage.Padding>
                <OnPlatform
                    x:TypeArguments="Thickness"
                    Android="0,0,0,0"
                    WinPhone="-18,0,-18,0"
                    iOS="0,0,0,0" />
            </ContentPage.Padding>
            <TableView BackgroundColor="White" HasUnevenRows="True">
                <TableRoot>
                    <TableSection x:Name="SessionLancamento">
                        <TableSection.Title>
                            <OnPlatform x:TypeArguments="x:String" Android="Preencha os campos obrigatórios ( * ) !" />
                        </TableSection.Title>

                        <ViewCell>
                            <Grid BackgroundColor="{StaticResource CinzaClarissimo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="INFO. CLIENTE"
                                    TextColor="{StaticResource CinzaEscuro}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </ViewCell>

                        <TextCell
                            Command="{Binding GoToClientesCommand}"
                            Detail="{Binding ItemCliente.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            PropertyChanging="BindableObject_OnPropertyChanging"
                            Text="Cliente *"
                            TextColor="{StaticResource AzulChart}" />

                        <ViewCell>
                            <StackLayout Margin="10,10,10,10" Orientation="Vertical">

                                <Grid Margin="10,10,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="Micro"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="ABERTO"
                                        TextColor="{StaticResource CinzaPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="Micro"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="VENCIDO"
                                        TextColor="{StaticResource CinzaPrincipal}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="Small"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding vFinanceiroEmAberto, Converter={StaticResource FormatDecimalConverter}}"
                                        TextColor="{StaticResource LaranjaPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontSize="Small"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding vFinanceiroVencido, Converter={StaticResource FormatDecimalConverter}}"
                                        TextColor="{StaticResource VermelhoPrincipal}"
                                        VerticalOptions="Center" />

                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="ButtonFinanceiro"
                                        Grid.Column="0"
                                        Command="{Binding GoToFinanceiroCommand}"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource Info}"
                                        Text="Financeiro" />
                                </Grid>

                            </StackLayout>
                        </ViewCell>

                        <ViewCell>
                            <Grid BackgroundColor="{StaticResource CinzaClarissimo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="LANÇAMENTO"
                                    TextColor="{StaticResource CinzaEscuro}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </ViewCell>

                        <TextCell
                            Command="{Binding ChangeTimePedidoCommand}"
                            Detail="{Binding currentModel.dEmissao, Converter={StaticResource DateTimeToExtenseFullDateConveter}}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            IsEnabled="{Binding IsBusy}"
                            Text="Data de Emissão"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            x:Name="DateOrcamentoCell"
                            Command="{Binding ChangeTimeOrcamentoCommand}"
                            Detail="{Binding currentModel.dtValidadeOrcamento, Converter={StaticResource DateTimeToExtenseFullDateConveter}}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Validade de Orçamento"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            Command="{Binding ChangeTipoLancamentoCommand}"
                            Detail="{Binding currentModel.TipoLancamento}"
                            DetailColor="{Binding ColorTipoLancamento}"
                            Text="Tipo de Documento"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            x:Name="StatusTextCell"
                            Command="{Binding GoToStatusCommand}"
                            Detail="{Binding ItemSatus.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            PropertyChanged="StatusTextCell_OnPropertyChanged"
                            Text="Status do Lançamento"
                            TextColor="{StaticResource AzulChart}" />


                        <TextCell
                            x:Name="TxtRepresentanteCell"
                            Command="{Binding GoToRepresentantesCommand}"
                            Detail="{Binding ItemRepresentante.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            PropertyChanged="TxtRepresentanteCell_OnPropertyChanged"
                            Text="Vendedor*"
                            TextColor="{StaticResource AzulChart}" />
                        <ViewCell>
                            <StackLayout Margin="10,10,10,10" Orientation="Vertical">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50*" />
                                        <ColumnDefinition Width="50*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="ButtonMostrarItens"
                                        Grid.Column="0"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource Info}"
                                        Text="{Binding CountItens, Converter={StaticResource DisplayToCountConverter}, ConverterParameter='Mostrar Itens ({0})'}" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="0,0,0,0"
                                        Command="{Binding GoToProdutosCommand}"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource Success}"
                                        Text="Adicionar*" />
                                </Grid>

                                <!--<Label  IsVisible="{Binding currentModel.bUsaMinimoVendas}"
                                        Text="{Binding currentModel.xMinimoVendas}" TextColor="{StaticResource VermelhoPrincipal}" FontSize="Small" />-->

                                <Grid Margin="10,10,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30*" />
                                        <ColumnDefinition Width="30*" />
                                        <ColumnDefinition Width="40*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        FontSize="Micro"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="DESCONTO"
                                        TextColor="{StaticResource CinzaPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="Micro"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="COMISSÃO"
                                        TextColor="{StaticResource CinzaPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        FontAttributes="Bold"
                                        FontSize="Micro"
                                        HorizontalOptions="End"
                                        HorizontalTextAlignment="End"
                                        Text="TOTAL"
                                        TextColor="{StaticResource CinzaPrincipal}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        FontSize="Small"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding vDescontoTotal, Converter={StaticResource FormatDecimalConverter}}"
                                        TextColor="{StaticResource VermelhoPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        FontSize="Small"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding vTotalComissao, Converter={StaticResource FormatDecimalConverter}}"
                                        TextColor="{StaticResource AzulPrincipal}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        FontSize="Small"
                                        HorizontalOptions="End"
                                        HorizontalTextAlignment="End"
                                        Text="{Binding vSubTotal, Converter={StaticResource FormatDecimalConverter}}"
                                        TextColor="{StaticResource VerdePrincipal}"
                                        VerticalOptions="Center" />

                                </Grid>
                            </StackLayout>
                        </ViewCell>
                    </TableSection>

                    <TableSection x:Name="SectionAdicionais">

                        <!--<TextCell Command="{Binding GoToDescontoCommand}" Detail="{Binding xDisplayDesconto}" DetailColor="{StaticResource CinzaMaisEscuro}" TextColor="{StaticResource AzulChart}"  Text="Adicionar Desconto"/>-->

                        <ViewCell>
                            <Grid BackgroundColor="{StaticResource CinzaClarissimo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="PAGAMENTO"
                                    TextColor="{StaticResource CinzaEscuro}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </ViewCell>

                        <ViewCell Height="70">
                            <ViewCell.View>
                                <StackLayout Orientation="Horizontal">

                                    <!-- Mantém o clique da célula -->
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding GoToConficaoPgtoCommand}" />
                                    </StackLayout.GestureRecognizers>

                                    <!-- Informações da condição -->
                                    <StackLayout
                                        HorizontalOptions="StartAndExpand"
                                        Orientation="Vertical"
                                        VerticalOptions="Center">
                                        
                                        <Label
                                            Margin="15,3,0,0"
                                            FontSize="Medium"
                                            HorizontalOptions="StartAndExpand"
                                            Text="Condição de Pagamento *"
                                            TextColor="{StaticResource AzulChart}"
                                            VerticalOptions="Center" />
                                        
                                        <Label
                                            Margin="15,-3,0,0"
                                            FontSize="Small"
                                            HorizontalOptions="StartAndExpand"
                                            Text="{Binding ItemCondicaoPgto.Display}"
                                            TextColor="{StaticResource CinzaMaisEscuro}"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    
                                    <!-- Área do PIX -->
                                    <StackLayout
                                        Margin="0,6,10,0"
                                        IsVisible="{Binding bExibirGerarPix}"
                                        Orientation="Vertical"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center">
                                        
                                        <Label
                                            Margin="0,2,0,-2"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            Text="Gerar Pix"
                                            TextColor="{StaticResource AzulChart}" />
                                        
                                        <CheckBox
                                            Margin="0,-8,0,0"
                                            HorizontalOptions="Center"
                                            IsChecked="{Binding currentModel.bGerarPix, Mode=TwoWay}"
                                            Scale="0.82"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                    
                                    <!-- Botão de configuração / Duplicatas Manual — abre PageTabelaFaturas -->
                                    <Button
                                        Margin="0,0,20,0"
                                        Command="{Binding GoToFaturasCommand}"
                                        CornerRadius="10"
                                        HeightRequest="40"
                                        HorizontalOptions="End"
                                        ImageSource="{Binding ImageConfig}"
                                        Style="{StaticResource Info}"
                                        VerticalOptions="CenterAndExpand"
                                        WidthRequest="40" />
                                </StackLayout>
                            </ViewCell.View>
                        </ViewCell>

                        <!--<TextCell
                            Height="60"
                            Command="{Binding GoToFormaPgtoCommand}"
                            Detail="{Binding ItemFormaPgto.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Forma de Pagamento"
                            TextColor="{StaticResource AzulChart}" />

                        <ViewCell>
                            <Grid BackgroundColor="{StaticResource CinzaClarissimo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="ENTREGA"
                                    TextColor="{StaticResource CinzaEscuro}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </ViewCell>-->

                        <TextCell
                            Command="{Binding GoToTransportadoraCommand}"
                            Detail="{Binding ItemTransportadora.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Transportadora"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            Command="{Binding GoToComplementosCommand}"
                            Detail="{Binding xDisplayComplementos}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Adicionar complementos"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            Command="{Binding GoToRedespachoCommand}"
                            Detail="{Binding ItemRedespacho.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Redespacho"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            Command="{Binding ChangeTimePrevisaoCommand}"
                            Detail="{Binding currentModel.dtPrevisto, Converter={StaticResource DateTimeToExtenseFullDateConveter}}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            IsEnabled="{Binding IsBusy}"
                            Text="Data de Previsão"
                            TextColor="{StaticResource AzulChart}" />

                        <TextCell
                            Command="{Binding GoToEnderecoCommand}"
                            Detail="{Binding ItemEndereco.Detail}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Endereço de entrega"
                            TextColor="{StaticResource AzulChart}" />

                        <ViewCell>
                            <Grid BackgroundColor="{StaticResource CinzaClarissimo}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="INFO. ADICIONAIS"
                                    TextColor="{StaticResource CinzaEscuro}"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </ViewCell>


                        <ViewCell>
                            <StackLayout Margin="10,5,10,0" Orientation="Vertical">
                                <Button
                                    Margin="5,0,5,5"
                                    Command="{Binding GoToEstoqueCommand}"
                                    HorizontalOptions="FillAndExpand"
                                    IsVisible="{Binding currentModel.EstoqueInvalido}"
                                    Style="{StaticResource Danger}"
                                    Text="Produtos sem estoque" />

                                <!--  Pedido de compra  -->
                                <Label
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="Pedido de compra" />
                                <custom:ExtendedEntry
                                    x:Name="EntryPedidoCompra"
                                    MaxLength="30"
                                    Text="{Binding currentModel.xPedidoCompra}" />

                                <!--  Info NF  -->
                                <Label
                                    IsVisible="{Binding ShowTxtInfoNF}"
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="Info. Nota Fiscal" />
                                <custom:ExtendedEntry
                                    x:Name="EntryInfoNF"
                                    IsVisible="{Binding ShowTxtInfoNF}"
                                    MaxLength="50"
                                    Text="{Binding currentModel.xInfoAdicionaisParaNF}" />

                                <!--  Observação  -->
                                <Label
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="Observações" />
                                <Editor
                                    x:Name="InfoAdicionais"
                                    HeightRequest="{StaticResource HeightEditor}"
                                    HorizontalOptions="FillAndExpand"
                                    Keyboard="Chat"
                                    Text="{Binding currentModel.xInfAdicional}"
                                    VerticalOptions="FillAndExpand" />

                                <!--  Anotação interna  -->
                                <Label
                                    LineBreakMode="NoWrap"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="Anotação privada" />
                                <Editor
                                    x:Name="ObsInterna"
                                    HeightRequest="{StaticResource HeightEditor}"
                                    HorizontalOptions="FillAndExpand"
                                    Keyboard="Chat"
                                    Text="{Binding currentModel.xObsInterna}"
                                    VerticalOptions="FillAndExpand" />

                                <StackLayout IsVisible="{Binding bCancelado}" Orientation="Vertical">
                                    <Label
                                        FontAttributes="Bold"
                                        Text="Motivo do Cancelamento"
                                        TextColor="{StaticResource VermelhoPrincipal}" />
                                    <Editor
                                        x:Name="EditorMotivoCancelamento"
                                        HeightRequest="80"
                                        Keyboard="Chat"
                                        Text="{Binding currentModel.xMotivoCancelamento}" />
                                </StackLayout>
                            </StackLayout>
                        </ViewCell>

                        <ViewCell>
                            <StackLayout
                                Margin="10,10,10,10"
                                IsVisible="{Binding ShowBotaoContrato}"
                                Orientation="Vertical">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Clicked="Editor_OnClicked"
                                        HorizontalOptions="FillAndExpand"
                                        Style="{StaticResource Info}"
                                        Text="Contrato" />
                                </Grid>
                            </StackLayout>
                        </ViewCell>

                        <TextCell
                            x:Name="TextCellRepresentacoesPdf"
                            Command="{Binding GoToRepresentacoesCommand}"
                            Detail="{Binding representada.Display}"
                            DetailColor="{StaticResource CinzaMaisEscuro}"
                            Text="Representações PDF"
                            TextColor="{StaticResource AzulChart}" />

                    </TableSection>

                </TableRoot>
            </TableView>
        </ContentPage>
        <ContentPage
            x:Name="PageItens"
            Title="Itens"
            BackgroundColor="{StaticResource Branco}"
            Icon="{StaticResource IconEstoque}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    x:Name="ListViewDados"
                    Grid.Row="0"
                    CachingStrategy="RecycleElement"
                    HasUnevenRows="True"
                    ItemsSource="{Binding currentModel.lItens}"
                    SelectedItem="{Binding currentModel.CurrentItemModel, Mode=TwoWay}">
                    <!--<ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>-->
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextCell
                                x:Name="TextCellItem"
                                Detail="{Binding xDetalheItem}"
                                DetailColor="{StaticResource VerdePrincipal}"
                                Text="{Binding xDescricao}"
                                TextColor="{Binding ItemJaIncluso, Converter={StaticResource BoolToColorConverterLitaItensPedido}}">
                                <TextCell.ContextActions>
                                    <ToolbarItem Command="{Binding EditItemPedidoCommand}" Text="Editar" />
                                    <ToolbarItem Command="{Binding RemoveItemCommand}" Text="Excluir" />
                                </TextCell.ContextActions>
                            </TextCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Label
                    Grid.Row="1"
                    Margin="5,5,5,5"
                    FontAttributes="Bold"
                    LineBreakMode="NoWrap"
                    Text="{Binding CountItens, Converter={StaticResource DisplayToCountConverter}, ConverterParameter='Total de itens ( {0} )'}"
                    TextColor="{StaticResource CinzaPrincipal}" />
            </Grid>

        </ContentPage>
    </TabbedPage.Children>
    <TabbedPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding CancelPedidoCommand}"
            Icon="{Binding ImageIconCancel}"
            Text="Cancelar">
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" Android="Secondary" />
            </ToolbarItem.Order>
        </ToolbarItem>
        <ToolbarItem
            Command="{Binding SaveCommand}"
            Icon="{Binding ImageIconSave}"
            Text="Salvar" />
    </TabbedPage.ToolbarItems>
</TabbedPage>