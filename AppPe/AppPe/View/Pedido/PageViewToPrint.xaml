<?xml version="1.0" encoding="utf-8" ?>
<pages:PopupPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageViewToPrint"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    Padding="15,30,15,15">
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True"
            PositionIn="Center"
            PositionOut="Center"
            ScaleIn="1.2"
            ScaleOut="0.8" />
    </pages:PopupPage.Animation>
    <pages:PopupPage.BindingContext>
        <pedido:PedidoToPrintViewModel />
    </pages:PopupPage.BindingContext>
    <Frame
        x:Name="FrameImpressao"
        Padding="0,0,0,0"
        BackgroundColor="White"
        HorizontalOptions="CenterAndExpand"
        OutlineColor="{StaticResource CinzaPrincipal}"
        VerticalOptions="CenterAndExpand">
        <Frame.HasShadow>
            <OnPlatform
                x:TypeArguments="x:Boolean"
                Android="True"
                WinPhone="False"
                iOS="True" />
        </Frame.HasShadow>
        <Grid Padding="2,2,2,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Margin=""  -->
            <Grid HorizontalOptions="End" VerticalOptions="Center">
                <Grid.Margin>
                    <OnPlatform
                        x:TypeArguments="Thickness"
                        Android="0,2,2,0"
                        WinPhone="20,-27,0,0" />
                </Grid.Margin>
                <abstractions:SvgImage
                    Command="{Binding CloseCommand}"
                    HeightRequest="25"
                    SvgPath="{StaticResource ImagemErrorPopup}"
                    WidthRequest="25" />
            </Grid>

            <ScrollView Grid.Row="1">
                <StackLayout
                    x:Name="MeuStackLayout"
                    Margin="5,5,5,5"
                    Orientation="Vertical">
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding xTitle}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding xEmpresa}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding xEnderecoEmpresa}" />
                    <Label
                        FontSize="Medium"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="NoWrap"
                        Text="{Binding Separador1}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding xCliente}" />
                    <Label
                        FontSize="Medium"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="NoWrap"
                        Text="{Binding Separador1}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding xheader_item}" />
                    <Label
                        FontSize="Medium"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="NoWrap"
                        Text="{Binding Separador1}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding itens}" />
                    <Label LineBreakMode="WordWrap" Text="{Binding totais}" />
                    <Image
                        x:Name="imgAssinaturaPedido"
                        HorizontalOptions="CenterAndExpand"
                        Source="{Binding imgAssinaturaPedido}"
                        VerticalOptions="CenterAndExpand" />
                    <BoxView
                        Margin="15,5,15,0"
                        BackgroundColor="Black"
                        HeightRequest="1"
                        HorizontalOptions="Fill" />
                    <Label
                        Margin="0,5,0,30"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding xRazaoSocial}" />
                    <Label
                        HorizontalTextAlignment="End"
                        LineBreakMode="WordWrap"
                        Text="{Binding agradecimento}" />
                </StackLayout>
            </ScrollView>

            <Button
                Grid.Row="2"
                Margin="2,2,2,0"
                Clicked="BtnCompartilhar_Clicked"
                Style="{StaticResource Primary}"
                Text="COMPARTILHAR" />
            <Button
                Grid.Row="3"
                Margin="2,2,2,0"
                Command="{Binding PrintCommand}"
                IsVisible="{Binding bCanPrint}"
                Style="{StaticResource Success}"
                Text="IMPRIMIR VIA BLUETOOTH" />

            <!--<Button Text="{Binding xTextoPrint}" Style="{StaticResource Success}" Grid.Row="2" Command="{Binding PrintCommand}" Margin="2,2,2,0" />-->
        </Grid>
    </Frame>
</pages:PopupPage>