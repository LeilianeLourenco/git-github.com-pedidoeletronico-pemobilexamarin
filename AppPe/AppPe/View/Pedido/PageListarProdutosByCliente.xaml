<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Pedido.PageListarProdutosByCliente"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:listagemProdutoPedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml.ListagemProdutoPedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:pedido1="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
    Title="Produtos adquiridos"
    IsBusy="{Binding IsBusy}">

    <ContentPage.BindingContext>
        <pedido:PageListarProdutosByClienteViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <listagemProdutoPedido:DataTemplateFull x:Key="DataTemplateFull" />
            <pedido1:DisplayToCountConverter x:Key="DisplayToCountConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label
            Grid.Row="0"
            Margin="10,5,0,0"
            HorizontalOptions="StartAndExpand"
            LineBreakMode="NoWrap"
            Text="{Binding xNameCliente}"
            TextColor="{StaticResource CinzaPrincipal}" />

        <custom:InfiniteSimpleListView
            x:Name="ListViewDados"
            Grid.Row="1"
            HasUnevenRows="True"
            ItemTemplate="{StaticResource DataTemplateFull}"
            ItemsSource="{Binding Produtos}"
            LoadMoreCommand="{Binding LoadItensCommand}">
            <x:Arguments>
                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
            </x:Arguments>
            <!--<ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>-->
        </custom:InfiniteSimpleListView>


        <Label
            Grid.Row="2"
            Margin="10,0,0,0"
            FontSize="Medium"
            HorizontalTextAlignment="Start"
            Text="{Binding iCount, Converter={StaticResource DisplayToCountConverter}, ConverterParameter='Total de produtos ( {0} )'}"
            TextColor="{StaticResource CinzaPrincipal}" />

        <Frame
            Grid.Row="3"
            Margin="0,0,0,0"
            Padding="0,0,0,0"
            HasShadow="True">
            <Button
                Margin="0,0,0,0"
                Command="{Binding GerarPedido}"
                HorizontalOptions="FillAndExpand"
                Style="{StaticResource Success}"
                Text="Gerar pedido" />
        </Frame>
    </Grid>

</ContentPage>