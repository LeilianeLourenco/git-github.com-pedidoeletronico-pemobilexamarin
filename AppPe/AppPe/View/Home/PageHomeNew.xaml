<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Home.PageHomeNew"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.Custom;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:home="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Home;assembly=Xamarin.HLP.Mobile.AppPE"
    xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
    Title="Início"
    BackgroundColor="{StaticResource CinzaMedio}">
    <ContentPage.BindingContext>
        <home:HomeNewViewModel />
    </ContentPage.BindingContext>

    <ScrollView Orientation="Vertical">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <xaml:MyCardView
                Title="{Binding xEmpresaAtual}"
                Grid.Row="0"
                BackgroundColor="White"
                CardImage="{Binding ImgEmpresa}"
                Display="{Binding xEmailUser}"
                IsCardView="True" />

            <Frame
                x:Name="GridCard"
                Grid.Row="1"
                Margin="0,1,0,1"
                Padding="0,0,0,0"
                BackgroundColor="White"
                HasShadow="True">
                <Grid Margin="0,10,0,10" ColumnSpacing="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Margin="0,5,0,5"
                        FontSize="Large"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Meta mensal"
                        TextColor="{StaticResource CinzaPrincipal}" />

                    <Grid Grid.Row="1" Padding="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            FontSize="Micro"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="{Binding dashmensal.dVendido, Converter={StaticResource FormatDecimalConverter}}"
                            TextColor="{StaticResource VerdePrincipal}" />

                        <Label
                            Grid.Column="1"
                            FontSize="Micro"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="{Binding dashmensal.dFaltante, Converter={StaticResource FormatDecimalConverter}}"
                            TextColor="{StaticResource VermelhoPrincipal}" />
                    </Grid>

                    <Grid
                        Grid.Row="2"
                        Margin="5,0,5,0"
                        ColumnSpacing="0"
                        RowSpacing="0">
                        <BoxView
                            BackgroundColor="{StaticResource VermelhoPrincipal}"
                            HeightRequest="8"
                            HorizontalOptions="End"
                            WidthRequest="{Binding dashmensal.WidthGridBoxDashFaltante}" />
                        <BoxView
                            BackgroundColor="{StaticResource VerdePrincipal}"
                            HeightRequest="8"
                            HorizontalOptions="Start"
                            WidthRequest="{Binding dashmensal.WidthGridBoxDashVendido}" />
                    </Grid>


                    <Label
                        Grid.Row="3"
                        FontSize="Micro"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding dashmensal.xMeta}"
                        TextColor="{StaticResource CinzaPrincipal}" />

                    <Grid
                        Grid.Row="4"
                        Margin="5,0,5,0"
                        RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="Micro"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="Vendido"
                            TextColor="{StaticResource CinzaApresentacaoCliente}" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontSize="Micro"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="Faltante"
                            TextColor="{StaticResource CinzaApresentacaoCliente}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="Large"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="{Binding dashmensal.pVendido}"
                            TextColor="{StaticResource CinzaPrincipal}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="Large"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="{Binding dashmensal.pFaltante}"
                            TextColor="{StaticResource CinzaPrincipal}" />
                    </Grid>

                    <StackLayout
                        Grid.Row="5"
                        Margin="5,5,0,0"
                        Orientation="Vertical">
                        <Label
                            FontSize="13"
                            Text="{Binding dashmensal.xDisplay1}"
                            TextColor="{StaticResource CinzaApresentacaoCliente}" />
                        <Label
                            FontSize="11"
                            IsVisible="{Binding dashmensal.xDisplay2, Converter={StaticResource IsNullOrEmptyConverter}}"
                            Text="{Binding dashmensal.xDisplay2}"
                            TextColor="{StaticResource VermelhoPrincipal}" />
                    </StackLayout>


                    <StackLayout
                        Grid.Row="6"
                        Margin="5,5,0,0"
                        Orientation="Vertical">
                        <Label
                            FontSize="13"
                            Text="Total de vendas emitidas no mês"
                            TextColor="{StaticResource CinzaApresentacaoCliente}" />
                        <Label Text="{Binding xVendasEmitidasMes}" TextColor="{StaticResource VerdeClaro}" />
                    </StackLayout>

                </Grid>
            </Frame>

            <Frame
                Grid.Row="2"
                Margin="0,0,0,1"
                Padding="0,0,0,0"
                BackgroundColor="White"
                HasShadow="True">
                <StackLayout Margin="2,10,2,10" Orientation="Vertical">
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <custom:GridButton
                            x:Name="GridEmpresa"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource AzulChart}"
                            HeightRequest="40">
                            <custom:GridButton.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </custom:GridButton.ColumnDefinitions>
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontFamily="Segoe UI"
                                Text="EMPRESA"
                                TextColor="White"
                                VerticalOptions="Center">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">
                                        <OnPlatform.Android>16</OnPlatform.Android>
                                        <OnPlatform.WinPhone>16</OnPlatform.WinPhone>
                                        <OnPlatform.iOS>12</OnPlatform.iOS>
                                    </OnPlatform>
                                </Label.FontSize>
                            </Label>
                        </custom:GridButton>

                        <custom:GridButton
                            x:Name="GridDash"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource LaranjaPrincipal}"
                            HeightRequest="40">
                            <custom:GridButton.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </custom:GridButton.ColumnDefinitions>
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontFamily="Segoe UI"
                                Text="DASHBOARD"
                                TextColor="White"
                                VerticalOptions="Center">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">
                                        <OnPlatform.Android>16</OnPlatform.Android>
                                        <OnPlatform.WinPhone>16</OnPlatform.WinPhone>
                                        <OnPlatform.iOS>12</OnPlatform.iOS>
                                    </OnPlatform>
                                </Label.FontSize>
                            </Label>
                        </custom:GridButton>

                        <custom:GridButton
                            x:Name="GridSincronizar"
                            Grid.Column="2"
                            BackgroundColor="{StaticResource VerdeClaro}"
                            HeightRequest="40">
                            <custom:GridButton.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </custom:GridButton.ColumnDefinitions>
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontFamily="Segoe UI"
                                Text="SINCRONIZAR"
                                TextColor="White"
                                VerticalOptions="Center">
                                <Label.FontSize>
                                    <OnPlatform x:TypeArguments="x:Double">
                                        <OnPlatform.Android>16</OnPlatform.Android>
                                        <OnPlatform.WinPhone>16</OnPlatform.WinPhone>
                                        <OnPlatform.iOS>12</OnPlatform.iOS>
                                    </OnPlatform>
                                </Label.FontSize>
                            </Label>
                        </custom:GridButton>
                    </Grid>

                    <Label
                        FontSize="Large"
                        HorizontalTextAlignment="Center"
                        Text="Informações"
                        TextColor="{StaticResource CinzaPrincipal}" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50*" />
                            <ColumnDefinition Width="50*" />
                        </Grid.ColumnDefinitions>

                        <StackLayout
                            HorizontalOptions="Center"
                            Orientation="Vertical"
                            Spacing="0">
                            <Label
                                FontSize="Medium"
                                HorizontalTextAlignment="Center"
                                Text="{Binding xDisplayConexao}"
                                TextColor="{Binding corConexao}" />
                            <Label
                                FontSize="Micro"
                                HorizontalTextAlignment="Center"
                                Text="internet"
                                TextColor="{StaticResource CinzaApresentacaoCliente}" />
                        </StackLayout>

                        <StackLayout
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Orientation="Vertical"
                            Spacing="0">
                            <Label
                                FontSize="Medium"
                                HorizontalTextAlignment="Center"
                                Text="{Binding xDateSync}"
                                TextColor="{StaticResource CinzaPrincipal}" />
                            <Label
                                FontSize="Micro"
                                HorizontalTextAlignment="Center"
                                Text="sincronizado"
                                TextColor="{StaticResource CinzaApresentacaoCliente}" />
                        </StackLayout>

                    </Grid>
                </StackLayout>
            </Frame>
        </Grid>

    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding GoToAgendaCommand}"
            Icon="{Binding ImageIconListarAgenda}"
            Text="Agenda">
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" WinPhone="Secondary" />
            </ToolbarItem.Order>
        </ToolbarItem>
        <ToolbarItem
            Command="{Binding GoToListaPreCommand}"
            Icon="{Binding ImageIconListarPreco}"
            Text="Lista Preço" />
        <ToolbarItem
            Command="{Binding GoToClientesCommand}"
            Icon="{Binding ImageIconListarClientes}"
            Text="Clientes">
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" WinPhone="Secondary" />
            </ToolbarItem.Order>
        </ToolbarItem>
        <!--<ToolbarItem Text="Produtos" Icon="{Binding ImageIconListarProdutos}" Command="{Binding GoToProdutosCommand}" >
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" WinPhone="Secondary"/>
            </ToolbarItem.Order>
        </ToolbarItem>-->
        <ToolbarItem
            Command="{Binding GoToPedidosCommand}"
            Icon="{Binding ImageIconPedido}"
            Text="Pedidos" />
    </ContentPage.ToolbarItems>
</ContentPage>