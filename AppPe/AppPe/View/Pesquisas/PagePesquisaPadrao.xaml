<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pesquisa="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Pesquisa;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.View.Pesquisas.PagePesquisaPadrao" IsBusy="{Binding IsBusy}">
    <ContentPage.BindingContext>
        <pesquisa:PesquisaPadraoViewModel/>
    </ContentPage.BindingContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid IsVisible="{Binding bFind}" Padding="5,5,5,5">
            <xaml:SearchPE x:Name="SearchBarPesquisa" SearchCommand="{Binding SearchCommand}" Placeholder="pesquisar..." Text="{Binding xFiltro, Mode=TwoWay}" />
        </Grid>
        <custom:InfiniteSimpleListView x:Name="ListViewDados" Grid.Row="1" ItemsSource="{Binding LItens}"
                                 SelectedItem="{Binding ItemSelected}"
                                 LoadMoreCommand="{Binding LoadItensCommand}"
                                 ItemSelected="ListView_OnItemSelected" >
            <x:Arguments>
                <ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>
            </x:Arguments>
            <!--<ListViewCachingStrategy>RecycleElement</ListViewCachingStrategy>-->
            <custom:InfiniteSimpleListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Display }" Detail="{Binding Detail}" TextColor="{StaticResource CinzaEscuro}" DetailColor="{StaticResource CinzaApresentacaoCliente}" />
                </DataTemplate>
            </custom:InfiniteSimpleListView.ItemTemplate>

        </custom:InfiniteSimpleListView>
    </Grid>
    <ContentPage.ToolbarItems>
        <ToolbarItem Icon="{Binding ImageIconSearch}" Command="{Binding HabiliteToSearchCommand}"/>
    </ContentPage.ToolbarItems>
</ContentPage>