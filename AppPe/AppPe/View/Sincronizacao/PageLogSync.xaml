<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Sincronizacao.PageLogSync"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sincronizacao="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Sincronizacao;assembly=Xamarin.HLP.Mobile.AppPE"
    Title="Avisos">

    <ContentPage.BindingContext>
        <sincronizacao:LogSincronizacaoViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label
                Margin="5,5,5,5"
                FontSize="Medium"
                HorizontalTextAlignment="Center"
                Text="Avisos da sincronização"
                TextColor="{StaticResource CinzaPrincipal}" />
            <ListView
                x:Name="ListViewAvisosSync"
                Grid.Row="1"
                Margin="0,5,0,5"
                HasUnevenRows="True"
                ItemSelected="ListView_OnItemSelected"
                ItemsSource="{Binding LAlertaSincronizacao}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!--<TextCell Text="{Binding Display}"  TextColor="{StaticResource VermelhoPrincipal}"
                                  Detail="{Binding Detail}" DetailColor="{StaticResource CinzaClaro}"/>-->
                        <ViewCell>
                            <StackLayout Orientation="Vertical">
                                <Label
                                    FontSize="Medium"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Display}"
                                    TextColor="{StaticResource VermelhoPrincipal}" />
                                <Label
                                    LineBreakMode="WordWrap"
                                    Text="{Binding Detail}"
                                    TextColor="{StaticResource CinzaClaro}" />
                                <Label
                                    LineBreakMode="WordWrap"
                                    Text="{Binding DetailEstoque}"
                                    TextColor="{StaticResource CinzaClaro}" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollView>


</ContentPage>