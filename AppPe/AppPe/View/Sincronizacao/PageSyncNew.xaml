<?xml version="1.0" encoding="UTF-8" ?>
<pages:PopupPage
    x:Class="Xamarin.HLP.Mobile.AppPE.View.Sincronizacao.PageSyncNew"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:animations="clr-namespace:Rg.Plugins.Popup.Animations;assembly=Rg.Plugins.Popup"
    xmlns:pages="clr-namespace:Rg.Plugins.Popup.Pages;assembly=Rg.Plugins.Popup"
    xmlns:sincronizacao="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Sincronizacao;assembly=Xamarin.HLP.Mobile.AppPE"
    Padding="40,40,40,40"
    HasSystemPadding="True">

    <pages:PopupPage.BindingContext>
        <sincronizacao:SincronizacaoNewViewModel />
    </pages:PopupPage.BindingContext>
    <pages:PopupPage.Animation>
        <animations:ScaleAnimation
            DurationIn="400"
            DurationOut="300"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="True"
            PositionIn="Center"
            PositionOut="Center"
            ScaleIn="1.2"
            ScaleOut="0.8" />
    </pages:PopupPage.Animation>

    <Frame
        BackgroundColor="White"
        HorizontalOptions="FillAndExpand"
        OutlineColor="{StaticResource CinzaPrincipal}"
        VerticalOptions="Center">
        <Frame.HasShadow>
            <OnPlatform
                x:TypeArguments="x:Boolean"
                Android="True"
                WinPhone="False"
                iOS="True" />
        </Frame.HasShadow>
        <Grid Margin="5,5,5,5" RowSpacing="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                FontSize="Medium"
                HorizontalTextAlignment="Center"
                LineBreakMode="NoWrap"
                Text="Sincronizando"
                TextColor="{StaticResource CinzaMaisEscuro}" />

            <Label
                Grid.Row="1"
                FontSize="Medium"
                HorizontalTextAlignment="Center"
                LineBreakMode="NoWrap"
                Text="{Binding currentModel.xDetail}"
                TextColor="{StaticResource CinzaEscuro}" />

            <ActivityIndicator
                Grid.Row="2"
                Margin="0,5,0,5"
                IsRunning="True"
                Color="#27B5F3" />

            <Label
                Grid.Row="3"
                FontSize="Medium"
                HorizontalTextAlignment="Center"
                LineBreakMode="NoWrap"
                Text="{Binding currentModel.iCount}"
                TextColor="{StaticResource CinzaClaro}" />
        </Grid>
    </Frame>
</pages:PopupPage>
