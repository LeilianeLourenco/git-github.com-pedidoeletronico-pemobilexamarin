<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Cadastro;assembly=Xamarin.HLP.Mobile.AppPE"
            xmlns:generic="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Generic;assembly=Xamarin.HLP.Mobile.AppPE"
            xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
            xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.custom;assembly=Xamarin.HLP.Mobile.AppPE"
            xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
            x:Class="Xamarin.HLP.Mobile.AppPE.View.Cliente.PageCliente" >
    <TabbedPage.Title>
        <OnPlatform x:TypeArguments="x:String"  WinPhone="Cliente" Android="Cliente"/>
    </TabbedPage.Title>
    <TabbedPage.Resources>
        <ResourceDictionary>
            <generic:CpfMaskConverter x:Key="CpfMaskConverter"/>
            <generic:CNPJMaskConverter x:Key="CnpjMaskConverter"/>
        </ResourceDictionary>
    </TabbedPage.Resources>
    <TabbedPage.BindingContext>
        <viewModel:ClienteViewModel />
    </TabbedPage.BindingContext>



    <ContentPage x:Name="PagePrincipal" Title="Informações" Icon="{StaticResource IconCliente}" Padding="{StaticResource PaddingContentPageComHeader2}">
        <ScrollView>

            <StackLayout Orientation="Vertical" Padding="20,10,20,0">

                <xaml:GridSeparador Text="DADOS DO CLIENTE"/>

                <!--Nome-->

                <Label Text="Razão Social / Nome *" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry  MaxLength="200" x:Name="EntryNome" Text="{Binding currentModel.xRazaoSocial}" Placeholder="Nome"/>

                <!--Apelido-->

                <Label Text="Nome Fantasia / Apelido *" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry MaxLength="200" x:Name="EntryFantasia" Text="{Binding currentModel.xFantasia}" Placeholder="Apelido/Nome Fantasia"/>

                <!--Código Alternativo-->

                <Label Text="Código Alternativo*" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry MaxLength="50" x:Name="EntryAlternativo" Text="{Binding currentModel.cAlternativo}" Placeholder="Código Alternativo" />

                <!--Registro Ativo-->

                <Label Text="Cliente ativo ?" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <Switch IsToggled="{Binding currentModel.stAtivo}" HorizontalOptions="Start"/>


                <xaml:GridSeparador Text="DOCUMENTOS"/>

                <!--Tipo de Pessoa-->

                <Label Text="Pessoa jurídica / física" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <Picker SelectedIndexChanged="BindableTipoPessoa_OnSelectedIndexChanged" SelectedIndex="{Binding currentModel.stJuridico}" x:Name="BindableTipoPessoa">
                    <Picker.Items>
                        <x:String>FÍSICA</x:String>
                        <x:String>JURÍDICA</x:String>
                    </Picker.Items>
                </Picker>

                <!--CPF-->

                <Label IsVisible="{Binding currentModel.bMostraCPF}" Text="CPF" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry IsVisible="{Binding currentModel.bMostraCPF}" MaxLength="18" Placeholder="Digite um valor válido" x:Name="EntryCpf"
                           Text="{Binding currentModel.xCpfCnpj, Converter={StaticResource CpfMaskConverter}}" TextChanged="EntryCpfCnpj_OnTextChanged" Keyboard="Numeric" />

                <!--RG-->

                <Label Text="RG" IsVisible="{Binding currentModel.bMostraCPF}" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry x:Name="EntryRG" IsVisible="{Binding currentModel.bMostraCPF}" MaxLength="25" Placeholder="Digite um valor válido" Keyboard="Numeric"  Text="{Binding currentModel.xRgIe}" />

                <!--CNPJ-->

                <Label  IsVisible="{Binding currentModel.bMostraCNPJ}" Text="CNPJ" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <custom:ExtendedEntry IsVisible="{Binding currentModel.bMostraCNPJ}" MaxLength="18" Placeholder="Digite um valor válido" x:Name="EntryCnpj"
                           Text="{Binding currentModel.xCpfCnpj, Converter={StaticResource CnpjMaskConverter}}" TextChanged="EntryCpfCnpj_OnTextChanged" Keyboard="Numeric" />
                    
                    <Grid Grid.Column="1">
                        <abstractions:SvgImage  x:Name="btnExecutePesquisa" HorizontalOptions="Center" VerticalOptions="Center" >
                            <abstractions:SvgImage.SvgPath>
                                <OnPlatform x:TypeArguments="x:String" WinPhone="{StaticResource ImagemPesquisarListaProdutoAndroid}" Android="{StaticResource ImagemPesquisarListaProdutoAndroidNovo}" iOS="{StaticResource ImagemPesquisarListaProdutoAndroidNovo}"/>
                            </abstractions:SvgImage.SvgPath>
                            <abstractions:SvgImage.HeightRequest>
                                <OnPlatform x:TypeArguments="x:Double" WinPhone="40" Android="34" iOS="32"/>
                            </abstractions:SvgImage.HeightRequest>
                            <abstractions:SvgImage.WidthRequest>
                                <OnPlatform x:TypeArguments="x:Double" WinPhone="40" Android="34" iOS="32"/>
                            </abstractions:SvgImage.WidthRequest>
                        </abstractions:SvgImage>
                    </Grid>
                </Grid>

                

                <!--Inscrição Estadual-->

                <Label Text="Inscrição Estadual" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry x:Name="EntryIE" IsVisible="{Binding currentModel.bMostraCNPJ}" MaxLength="25" Placeholder="Digite um valor válido" Keyboard="Numeric"  Text="{Binding currentModel.xRgIe}" />

                <!--Linkedin-->

                <Label Text="Linkedin"  LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry x:Name="EntryUrlLinkedin"  MaxLength="150" Placeholder="URL"    Text="{Binding currentModel.xUrlLinkedin}" />


                <!--Instagram-->

                <Label Text="Instagram" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry x:Name="EntryUrlInstagram"  MaxLength="150" Placeholder="URL"  Text="{Binding currentModel.xUrlInstagram}" />

                <!--Facebook-->

                <Label Text="Facebook" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry x:Name="EntryUrlFacebook"  MaxLength="150" Placeholder="URL"    Text="{Binding currentModel.xUrlFacebook}" />

                
                
                <xaml:GridSeparador Text="EMAIL / TELEFONE"/>

                <xaml:FoneEmailControl x:Name="EmailControl" tipoCompoenent="EMAIL" InputField="{Binding currentModel.xEmails, Mode=TwoWay}"/>

                <xaml:FoneEmailControl x:Name="FoneControl" tipoCompoenent="TELEFONE" InputField="{Binding currentModel.xTelefones, Mode=TwoWay}"/>

                <!--Separador-->

                <xaml:GridSeparador Text="INFORMAÇÕES ADICIONAIS"/>


                <!--Usa Limite de Crédito-->

                <Label IsVisible="{Binding bAdmin}" Text="Usa Limite de Crédito" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <Switch IsVisible="{Binding bAdmin}" IsToggled="{Binding bUsaLimite}" HorizontalOptions="Start" />

                <!--Usa Limite de Crédito-->

                <Label IsVisible="{Binding bUsaLimite}" Text="Limite de Crédito" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <custom:ExtendedEntry IsEnabled="{Binding bAdmin}" IsVisible="{Binding bUsaLimite}" x:Name="EntryLimiteCredito" MaxLength="13" Keyboard="Numeric" Placeholder="Limite de crédito"
                          Text="{Binding currentModel.vLimiteCredito, Converter={StaticResource DecimalToStringConverter}} " />


                <!--Situação da Prospecção-->

                <Label Text="Situação da Prospecção" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <Picker SelectedIndex="{Binding indexStCliente}" x:Name="BindableSituacaoCliente">
                    <Picker.Items>
                        <x:String>EFETIVADO</x:String>
                        <x:String>EM PROSPECÇÃO</x:String>
                    </Picker.Items>
                </Picker>


                <!--Data de Efetivação-->

                <Label IsVisible="{Binding enableDateEfetivacao}" Text="Data Efetivação" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <DatePicker IsVisible="{Binding enableDateEfetivacao}" x:Name="DatePickerEfetivacao" Date="{Binding currentModel.dEfetivacao}" />

                <Label  Text="Anotações" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
                <Editor  x:Name="EditorAnotacao" Keyboard="Chat" HorizontalOptions="FillAndExpand"  VerticalOptions="FillAndExpand" HeightRequest="{StaticResource HeightEditor}" Text="{Binding currentModel.xAnotacao}" />

              <Label Text="Mostrar anotações no pedido ?" LineBreakMode="NoWrap" Style="{StaticResource HeaderLabel}"/>
              <Switch IsToggled="{Binding currentModel.bExibirAnotacaoNoPedido}" HorizontalOptions="Start"/>

            </StackLayout>

        </ScrollView>
    </ContentPage>

    <ContentPage Icon="{StaticResource IconListagem}" Title="Configurações" x:Name="PageAdicionais">
        <TableView BackgroundColor="White">
            <TableRoot Title="">
                <TableSection Title="ENDEREÇOS / CONTATOS">
                    <TextCell Command="{Binding ContatosCommand}" TextColor="{StaticResource AzulClaro}" DetailColor="{StaticResource CinzaPrincipal}"  Text="{Binding labelContatos}" Detail="clique para visualizar"/>
                    <TextCell Command="{Binding EnderecoCommand}" TextColor="{StaticResource AzulClaro}" DetailColor="{StaticResource CinzaPrincipal}"  Text="{Binding labelEnderecos}" Detail="clique para visualizar"/>
                </TableSection>

                <TableSection Title="PARÂMETROS">
                    <TextCell Command="{Binding SearchTabelaPrecoCommand}" Detail="{Binding tabelaPreco.Display}" DetailColor="{StaticResource CinzaPrincipal}" TextColor="{StaticResource AzulClaro}"  Text="Tabela de preço"/>
                    <TextCell Command="{Binding SearchTransportadoraCommand}" Detail="{Binding Transportadora.Display}" DetailColor="{StaticResource CinzaPrincipal}" TextColor="{StaticResource AzulClaro}"  Text="Transportadora"/>
                    <TextCell Command="{Binding SearchRedespachoCommand}" Detail="{Binding Redespacho.Display}" DetailColor="{StaticResource CinzaPrincipal}" TextColor="{StaticResource AzulClaro}"  Text="Redespacho"/>
                    <TextCell Command="{Binding SearchCondicaoPagamentoCommand}" Detail="{Binding CondicaoPgto.Display}" DetailColor="{StaticResource CinzaPrincipal}" TextColor="{StaticResource AzulClaro}"  Text="Condição de pagamento"/>
                    <TextCell Command="{Binding SearchRamoAtividadeCommand}" Detail="{Binding ramoAtividade.Display}" DetailColor="{StaticResource CinzaPrincipal}" TextColor="{StaticResource AzulClaro}"  Text="Ramo de atividade"/>
                </TableSection>
            </TableRoot>
        </TableView>
    </ContentPage>

    <TabbedPage.ToolbarItems>
        <ToolbarItem Icon="{Binding ImageIconCancel}" Text="Cancelar" Command="{Binding CancelCommand}">
            <ToolbarItem.Order>
                <OnPlatform x:TypeArguments="ToolbarItemOrder" Android="Secondary"/>
            </ToolbarItem.Order>
        </ToolbarItem>
        <ToolbarItem x:Name="ToolbarItemSalvar" Text="Salvar" Icon="{Binding ImageIconSave}" />
    </TabbedPage.ToolbarItems>
</TabbedPage>