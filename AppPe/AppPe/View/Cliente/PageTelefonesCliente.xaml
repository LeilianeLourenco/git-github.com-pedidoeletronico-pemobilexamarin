<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:xaml="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.xaml;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:cadastro="clr-namespace:Xamarin.HLP.Mobile.AppPE.ViewModel.Cadastro;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:generic="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Generic;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.View.Cliente.PageTelefonesCliente" Title="">
  <ContentPage.BindingContext>
    <cadastro:TelefoneClienteViewModel/>
  </ContentPage.BindingContext>
  <ContentPage.Resources>
    <ResourceDictionary>
      <x:String x:Key="ImagemPhone">Xamarin.HLP.Mobile.AppPE.Images.PagesIcon.ApplicationPhone.svg</x:String>
      <generic:FirstLetterConverter x:Key="FirstLetterConverter"/>
    </ResourceDictionary>
    
    
  </ContentPage.Resources>
  <Grid>
    <Grid.Padding>
      <OnPlatform x:TypeArguments="Thickness" WinPhone="0,0,0,0" iOS="0,0,0,0" Android="0,0,0,0"/>
    </Grid.Padding>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <xaml:GridSemRegistroEncontrado IsVisible="{Binding lEmailTelefoneAgrupado, Converter={StaticResource AnyRegisterListConverter}, ConverterParameter='N'}" Grid.Row="1"/>
    <ListView x:Name="ListEmailFone" Grid.Row="1"
           ItemsSource="{Binding lEmailTelefoneAgrupado}"
           IsVisible="{Binding lEmailTelefoneAgrupado, Converter={StaticResource AnyRegisterListConverter}, ConverterParameter='L'}"
              IsGroupingEnabled="True"
               GroupShortNameBinding="{Binding Key, Converter={StaticResource FirstLetterConverter}}"
                 GroupDisplayBinding="{Binding Key}"
           HasUnevenRows="True"
           ItemSelected="ListViewFoneEmail_OnItemSelected" >
      <ListView.ItemTemplate>
        <DataTemplate>
          <ViewCell>
            <StackLayout Padding="10,0,0,0">
              <Label Text="{Binding xDescricao}" FontAttributes="Bold" TextColor="{StaticResource CinzaEscuro}"></Label>
              <StackLayout Orientation="Vertical">
                <StackLayout Orientation="Horizontal" IsVisible="{Binding hasFone}" Padding="0,0,10,10">
                  <abstractions:SvgImage SvgPath="{StaticResource ImagemPhone}">
                    <abstractions:SvgImage.HeightRequest>
                      <OnPlatform x:TypeArguments="x:Double" WinPhone="30" iOS="18" Android="24"/>
                    </abstractions:SvgImage.HeightRequest>
                    <abstractions:SvgImage.WidthRequest>
                      <OnPlatform x:TypeArguments="x:Double" WinPhone="30" iOS="18" Android="24"/>
                    </abstractions:SvgImage.WidthRequest>
                  </abstractions:SvgImage>


                  <Label TextColor="{StaticResource CinzaPrincipal}" Text="{Binding xFone}" Style="{StaticResource Medium}"></Label>

                </StackLayout>

                <StackLayout Orientation="Horizontal" IsVisible="{Binding hasEmail}" Padding="0,0,10,10">

                  <abstractions:SvgImage SvgPath="{StaticResource ImagemEmail}">
                    <abstractions:SvgImage.HeightRequest>
                      <OnPlatform x:TypeArguments="x:Double" WinPhone="30" iOS="18" Android="24"/>
                    </abstractions:SvgImage.HeightRequest>
                    <abstractions:SvgImage.WidthRequest>
                      <OnPlatform x:TypeArguments="x:Double" WinPhone="30" iOS="18" Android="24"/>
                    </abstractions:SvgImage.WidthRequest>
                  </abstractions:SvgImage>

                  <Label TextColor="{StaticResource CinzaPrincipal}" Text="{Binding xEmail}" Style="{StaticResource Medium}"></Label>

                </StackLayout>

              </StackLayout>

            </StackLayout>
          </ViewCell>
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.GroupHeaderTemplate>
        <DataTemplate>
          <ViewCell>
            <ViewCell.Height>
              <OnPlatform x:TypeArguments="x:Double" Android="30" iOS="30" WinPhone="40"/>
            </ViewCell.Height>
            <StackLayout HorizontalOptions="Fill" VerticalOptions="Fill">
              <StackLayout.BackgroundColor>
                <OnPlatform x:TypeArguments="Color" Android="Transparent" iOS="Transparent" WinPhone="{StaticResource AzulSeparador}"/>
              </StackLayout.BackgroundColor>
              <Label Text="{Binding Key, Mode=OneWay}" HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" >
                <Label.TextColor>
                  <OnPlatform x:TypeArguments="Color"  Android="{StaticResource CinzaPrincipal}" iOS="{StaticResource CinzaPrincipal}" WinPhone="White"/>
                </Label.TextColor>
              </Label>
            </StackLayout>
          </ViewCell>
        </DataTemplate>
      </ListView.GroupHeaderTemplate>
    </ListView>
  </Grid>
</ContentPage>