<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:forms="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.Custom;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.Controls.xaml.MyCardView" BackgroundColor="White">


    <StackLayout Orientation="Vertical">
        <Frame x:Name="GridCard" IsVisible="False" HasShadow="True" Padding="0,0,0,0" >
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <custom:GridButton x:Name="ButtonClick">
                    <forms:CachedImage x:Name="ImgCard1" HeightRequest="175" CacheType="Disk"
                           Aspect="AspectFill" />
                </custom:GridButton>
                <StackLayout Padding="18,8,0,10" Orientation="Vertical" Grid.Row="1">
                    <Label x:Name="LabelTitle1" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaEscuro}" FontSize="Medium"/>
                    <Label x:Name="LabelDisplay1" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaApresentacaoCliente}" FontSize="Small"/>
                </StackLayout>
            </Grid>
        </Frame>

        <Grid x:Name="GridListItem" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <forms:CachedImage x:Name="ImgCard2" HorizontalOptions="Center" VerticalOptions="Center" Grid.Column="0" Grid.Row="0" CacheType="Disk" >
                <forms:CachedImage.HeightRequest>
                    <OnPlatform x:TypeArguments="x:Double" Android="80" WinPhone="80" iOS="90"/>
                </forms:CachedImage.HeightRequest>
                <forms:CachedImage.WidthRequest>
                    <OnPlatform x:TypeArguments="x:Double" Android="80" WinPhone="80" iOS="90"/>
                </forms:CachedImage.WidthRequest>
            </forms:CachedImage>

            <StackLayout Grid.Row="0" Grid.Column="1" Padding="18,8,0,10" Orientation="Vertical" >
                <Label x:Name="LabelTitle2" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaEscuro}" FontSize="Medium"/>
                <Label x:Name="LabelDisplay2" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" TextColor="{StaticResource CinzaApresentacaoCliente}" FontSize="Small"/>
            </StackLayout>
        </Grid>

    </StackLayout>


</Grid>