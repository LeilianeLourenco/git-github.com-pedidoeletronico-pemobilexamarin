<?xml version="1.0" encoding="utf-8" ?>
<custom:GridButton xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:abstractions="clr-namespace:Xamarin.HLP.Mobile.AppPE.Abstractions;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:controls="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:model="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:custom="clr-namespace:Xamarin.HLP.Mobile.AppPE.Controls.Custom;assembly=Xamarin.HLP.Mobile.AppPE" 
             x:Class="Xamarin.HLP.Mobile.AppPE.Controls.xaml.GridToFind" Padding="0,10,10,10">

  <custom:GridButton.BindingContext>
    <model:FindGenericModel/>
  </custom:GridButton.BindingContext>

  <custom:GridButton.RowDefinitions>
    <RowDefinition Height="{StaticResource HeighRowDefault}" />
  </custom:GridButton.RowDefinitions>
  <custom:GridButton.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="30"/>
  </custom:GridButton.ColumnDefinitions>

  <Grid x:Name="GridImage" Grid.Row="0" Grid.Column="0">
    <Grid.Padding>
      <OnPlatform x:TypeArguments="Thickness" Android="10,0,0,-8" WinPhone="0,0,0,-8" iOS="10,0,0,8"/>
    </Grid.Padding>

    <abstractions:SvgImage SvgPath="{Binding Image}"
             WidthRequest="{StaticResource HeightandWidth}" HeightRequest="{StaticResource HeightandWidth}" HorizontalOptions="Center"
             VerticalOptions="Center"/>

  </Grid>

  <Grid Grid.Column="1" Grid.Row="0">
    <Grid.Padding>
      <OnPlatform x:TypeArguments="Thickness" Android="10,0,0,-8" WinPhone="10,10,0,0" iOS="10,-8,0,0"/>
    </Grid.Padding>

    <StackLayout Orientation="Vertical" VerticalOptions="CenterAndExpand">
      <StackLayout Padding="0,-5,0,0">
        <Label Text="{Binding Display}" TextColor="{StaticResource CinzaEscuro}" FontAttributes="Bold" />
      </StackLayout>
      <StackLayout Padding="0,-5,0,0">
        <Label Text="{Binding Detail}"  TextColor="{Binding SelectedItem.ColorDetail}" />
      </StackLayout>
    </StackLayout>

  </Grid>

  <abstractions:SvgImage
               SvgPath="{Binding ApplicationViewCellSelect}"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
               Aspect="Fill" Grid.Column="2" Grid.Row="0"   >
    <abstractions:SvgImage.HeightRequest>
      <OnPlatform x:TypeArguments="x:Double" Android="12" WinPhone="12" iOS="12"/>
    </abstractions:SvgImage.HeightRequest>
    <abstractions:SvgImage.WidthRequest>
      <OnPlatform x:TypeArguments="x:Double" Android="12" WinPhone="12" iOS="12"/>
    </abstractions:SvgImage.WidthRequest>
  </abstractions:SvgImage>

</custom:GridButton>