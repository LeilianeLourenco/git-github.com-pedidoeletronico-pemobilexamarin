<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Xamarin.HLP.Mobile.AppPE.Controls.xaml.StepperDefault">

  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="50*"/>
    <ColumnDefinition Width="50*"/>
  </Grid.ColumnDefinitions>

  <Button x:Name="btnMenos" Text="-" Grid.Column="0" Clicked="ValueChanged_OnClicked"/>
  <Button x:Name="btnMais" Text="+" Grid.Column="1" Clicked="ValueChanged_OnClicked"/>

</Grid>