<?xml version="1.0" encoding="utf-8" ?>
<StackLayout  xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pedido="clr-namespace:Xamarin.HLP.Mobile.AppPE.View.Converter.Pedido;assembly=Xamarin.HLP.Mobile.AppPE"
             xmlns:lancamento="clr-namespace:Xamarin.HLP.Mobile.AppPE.Model.Lancamento;assembly=Xamarin.HLP.Mobile.AppPE"
             x:Class="Xamarin.HLP.Mobile.AppPE.Controls.xaml.VariacaoEditItemPedido" Padding="5,5,5,5">


    <StackLayout Orientation="Vertical" Spacing="10">
        <Label Text="{Binding xNomeVariacao}" TextColor="#000" FontSize="15"/>

        <StackLayout Orientation="Horizontal" Spacing="10" x:Name="ScrollButtonsVariacoes"
             BindableLayout.ItemsSource="{Binding lTiposVariacoes}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding NomeVariacao}" 
                            FontSize="13"                                              
                            BackgroundColor="#fff"
                            BorderColor="LightGray"
                            BorderWidth="2" 
                            CornerRadius="10" 
                            WidthRequest="100" 
                            HeightRequest="50"
                            Clicked="btnFiltroVariacao"
                            Command="{Binding CurrentLocalEstoque, Mode=TwoWay}"
                            CommandParameter="{Binding idProdutoLista}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </StackLayout>

    </StackLayout>

</StackLayout>